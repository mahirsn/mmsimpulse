#!/bin/bash
# mmsimpulse session.
#
# A Wayland session made of a KWin compositor and the mmsimpulse shell, and
# nothing else. There is no desktop environment here — no plasmashell, no
# session manager, no Plasma workspace. Everything a Plasma session would
# normally provide and the shell actually needs is started explicitly below.
#
# Works with any KWin 6 that provides kwin_wayland. Nothing below assumes a
# particular build of it.
#
# Deliberately not `set -e`: the supervisor loop at the end has to survive the
# shell exiting non-zero, which is exactly when it needs to restart it.
set -uo pipefail

CONFIG=mmsimpulse

# Which shell provides the widgets. The session keeps its own identity either
# way — the log, the Wayland socket and the bin directory are still mmsimpulse —
# so only the shell changes. Pick one with MMSIMPULSE_SHELL, or by writing its
# name into ~/.config/mmsimpulse/shell.
#
# The name is a Quickshell configuration (quickshell/<name>/shell.qml), or a
# profile: a file of that name in ~/.config/mmsimpulse/profiles or
# ~/.local/share/mmsimpulse/profiles that says how to start a shell and what
# each shortcut runs in it. The repository's profiles/ has the format.
#
# A session whose shell does not exist has no bar, no launcher and no way to
# start anything, which is unrecoverable without a TTY. So a name that resolves
# to neither falls back to ours rather than being taken at its word.
SHELL_CONFIG="${MMSIMPULSE_SHELL:-}"
[[ -n "$SHELL_CONFIG" ]] ||
    SHELL_CONFIG="$(head -n1 "$HOME/.config/$CONFIG/shell" 2>/dev/null | tr -d '[:space:]')"
SHELL_CONFIG="${SHELL_CONFIG:-$CONFIG}"
PROFILE=""
if [[ "$SHELL_CONFIG" != "$CONFIG" ]]; then
    found=""
    for dir in "${XDG_CONFIG_HOME:-$HOME/.config}/$CONFIG/profiles" "$HOME/.local/share/$CONFIG/profiles"; do
        [[ -f "$dir/$SHELL_CONFIG" ]] && { PROFILE="$dir/$SHELL_CONFIG"; found=1; break; }
    done
    for dir in "${XDG_CONFIG_HOME:-$HOME/.config}" /etc/xdg; do
        [[ -z "$found" && -f "$dir/quickshell/$SHELL_CONFIG/shell.qml" ]] && { found=1; break; }
    done
    if [[ -z "$found" ]]; then
        echo "Shell '$SHELL_CONFIG' has no profile and no shell.qml; falling back to $CONFIG" >&2
        SHELL_CONFIG="$CONFIG"
    fi
fi
# A profile line is `key=command`.
profile() { [[ -n "$PROFILE" ]] && sed -n "s/^$1=//p" "$PROFILE" | tail -n1; }
SHELL_CMD="$(profile start)"
SHELL_CMD="${SHELL_CMD:-qs -c $SHELL_CONFIG}"

LOG="$HOME/.local/share/$CONFIG.log"
mkdir -p "$(dirname "$LOG")"
# Everything that writes here appends, so that a crash-looping shell cannot
# erase the trace of why it crashed. Emptying it once per session is what
# keeps it from growing forever.
: >"$LOG"

# ---------------------------------------------------------------------------
# Session identity
# ---------------------------------------------------------------------------
# KDE, not mmsimpulse: this is what selects the KWin backend in the shell, the
# KDE portal backend, and kde-open over the long-removed kfmclient in Electron
# apps. XDG_MENU_PREFIX is what lets kbuildsycoca6 build the application menu,
# without which global shortcuts and the launcher come up empty.
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export XDG_SESSION_TYPE=wayland
export KDE_SESSION_VERSION=6
export KDE_FULL_SESSION=true
export XDG_MENU_PREFIX=plasma-
export PATH="$HOME/.local/share/$CONFIG/bin:$HOME/.local/bin:$PATH"

# The skin's colour pipeline runs matugen and materialyoucolor out of a venv and
# finds it through this variable, which a Hyprland session exports and nothing
# here did. Without it switchwall.sh sources "/bin/activate", every generator
# dies on a missing module, and picking a wallpaper quietly changes no colours
# at all. Left alone if the login manager already set it.
export ILLOGICAL_IMPULSE_VIRTUAL_ENV="${ILLOGICAL_IMPULSE_VIRTUAL_ENV:-$HOME/.local/state/quickshell/.venv}"

# A Hyprland session exports QT_QPA_PLATFORM="wayland;xcb" and the user systemd
# manager outlives a logout, so the value leaks in here. Quickshell's IPC client
# does not recognise the multi-value form, decides the caller is on X11, and
# then refuses to talk to a shell it recorded as Wayland — which silently
# breaks every shortcut kglobalaccel launches.
unset QT_QPA_PLATFORM
systemctl --user unset-environment QT_QPA_PLATFORM 2>/dev/null

find_bin() {
    local name="$1" path
    for path in "/usr/libexec/$name" "/usr/lib/$name" "/usr/bin/$name" /usr/lib/*/libexec/"$name"; do
        [[ -x "$path" ]] && { printf '%s\n' "$path"; return 0; }
    done
    command -v "$name" 2>/dev/null
}

# ---------------------------------------------------------------------------
# A D-Bus session bus, for TTY logins that have none
# ---------------------------------------------------------------------------
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
    exec dbus-run-session -- "$0" "$@"
fi

# The shortcuts follow the shell. An entry install-shortcuts.sh marked as a
# shell action runs the profile's command for it, or nothing when the profile
# has none; a Quickshell configuration gets the IPC call ours answers.
#
# Done before the compositor starts: its global shortcut daemon reads each
# entry once, when it registers it, and keeps that command for the session.
# The service cache is rebuilt for the same reason when an entry changed.
#
# `env -u QT_QPA_PLATFORM` as in install-shortcuts.sh: a Quickshell IPC client
# that inherits a QT_QPA_PLATFORM cannot reach the shell.
for entry in "${XDG_DATA_HOME:-$HOME/.local/share}/applications/$CONFIG"-*.desktop; do
    action="$(sed -n 's/^X-Mmsimpulse-Action=//p' "$entry" 2>/dev/null)"
    [[ -n "$action" ]] || continue
    if [[ -n "$PROFILE" ]]; then
        cmd="$(profile "$action")"
        cmd="${cmd:+env -u QT_QPA_PLATFORM $cmd}"
        cmd="${cmd:-true}"
    else
        cmd="env -u QT_QPA_PLATFORM qs -c $SHELL_CONFIG ipc call $action trigger"
    fi
    grep -qxF "Exec=$cmd" "$entry" && continue
    while IFS= read -r line; do
        [[ "$line" == Exec=* ]] && line="Exec=$cmd"
        printf '%s\n' "$line"
    done <"$entry" >"$entry.new" && mv "$entry.new" "$entry"
    shortcuts_changed=1
done
# A profile can also bring keys of its own, so a shell keeps the keys it has on
# another compositor:
#
#   bind <keys>=<command>    a new global shortcut that runs the command
#   kwin <action>=<keys>     a KWin action, by its name in kglobalshortcutsrc
#
# Whatever else holds such a key gives it up for the session. What was changed
# is recorded and put back at the next login before the profile (or another
# one) is applied again, so changing or dropping the profile leaves the keys
# as they were.
python3 - "${XDG_CONFIG_HOME:-$HOME/.config}/kglobalshortcutsrc" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications" \
    "${XDG_STATE_HOME:-$HOME/.local/state}/$CONFIG/shortcuts.json" \
    "$PROFILE" "$CONFIG" <<'PY' && shortcuts_changed=1
import glob, json, os, re, sys

rc, appdir, state, profile, config = sys.argv[1:]
lines = open(rc).read().split("\n") if os.path.exists(rc) else []
saved = json.load(open(state)) if os.path.exists(state) else {}
old_entries = glob.glob(os.path.join(appdir, config + "-bind-*.desktop"))

binds, actions = [], []
for line in (open(profile).read().splitlines() if profile else []):
    if line.startswith("bind ") and "=" in line:
        keys, cmd = line[5:].split("=", 1)
        binds.append((keys.strip(), cmd.strip()))
    elif line.startswith("kwin ") and "=" in line:
        action, keys = line[5:].split("=", 1)
        actions.append((action.strip(), keys.strip()))
if not saved and not old_entries and not binds and not actions:
    sys.exit(1)

def find(group, key):
    """(index of the group header, index of the key's line or None)."""
    head, at = None, None
    for i, line in enumerate(lines):
        if line.startswith("["):
            if head is not None:
                break
            if line == "[%s]" % group:
                head = i
        elif head is not None and line.split("=", 1)[0] == key:
            at = i
    return head, at

def get(group, key):
    _, at = find(group, key)
    return None if at is None else lines[at].split("=", 1)[1]

def put(group, key, value):
    head, at = find(group, key)
    if value is None:
        if at is not None:
            del lines[at]
        return
    if at is not None:
        lines[at] = "%s=%s" % (key, value)
    elif head is not None:
        lines.insert(head + 1, "%s=%s" % (key, value))
    else:
        lines.extend(["", "[%s]" % group, "%s=%s" % (key, value)])

def change(group, key, value):
    saved.setdefault("%s\x1f%s" % (group, key), get(group, key))
    put(group, key, value)

# A value is "active,default,friendly name"; [services] entries have only the
# active part, read as one string. Keys inside a part are split by a literal
# \t; a comma in a key is escaped, except in that one string.
split = lambda v: re.split(r"(?<!\\),", v)
keys_of = lambda part: [k.replace("\\,", ",") for k in part.split("\\t") if k and k != "none"]
join = lambda keys, esc=True: "\\t".join(k.replace(",", "\\,") if esc else k for k in keys) or "none"

# Put back what the last login changed.
for gk, value in saved.items():
    put(*gk.split("\x1f"), value)
saved = {}
for path in old_entries:
    os.remove(path)
lines = [l for i, l in enumerate(lines)
         if not (l.startswith("[services][%s-bind-" % config) and
                 (i + 1 >= len(lines) or lines[i + 1].startswith("[") or not lines[i + 1]))]

claimed = {k for keys, _ in binds for k in keys_of(keys)} | \
          {k for _, keys in actions for k in keys_of(keys)}
group = None
for i, line in enumerate(list(lines)):
    if line.startswith("["):
        group = line[1:-1]
        continue
    if "=" not in line or line.startswith("_k_friendly_name"):
        continue
    key, value = line.split("=", 1)
    parts = [value] if group.startswith("services]") else split(value)
    held = keys_of(parts[0])
    if claimed & set(held):
        parts[0] = join([k for k in held if k not in claimed], not group.startswith("services]"))
        change(group, key, ",".join(parts))

# An application entry bound to its own default key has no line in the file
# (the daemon drops it), and takes that key again when it registers. Such an
# entry gets an explicit binding without the claimed key.
dirs = [appdir] + [os.path.join(d, "applications") for d in
                   os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
seen = set()
for d in dirs:
    for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
        name = os.path.basename(path)
        if name in seen:
            continue
        seen.add(name)
        try:
            text = open(path, errors="replace").read()
        except OSError:
            continue
        m = re.search(r"^X-KDE-Shortcuts=(.*)$", text, re.M)
        if not m or name.startswith(config + "-bind-") or get("services][" + name, "_launch") is not None:
            continue
        held = [k.strip() for k in m.group(1).split(",") if k.strip()]
        if claimed & set(held):
            change("services][" + name, "_launch", join([k for k in held if k not in claimed], False))

for action, keys in actions:
    parts = split(get("kwin", action) or ",none,%s" % action)
    parts[0] = join(keys_of(keys))
    change("kwin", action, ",".join(parts))

for n, (keys, cmd) in enumerate(binds, 1):
    name = "%s-bind-%d.desktop" % (config, n)
    with open(os.path.join(appdir, name), "w") as f:
        f.write("[Desktop Entry]\nType=Application\nName=%s: %s\nExec=%s\n"
                "NoDisplay=true\nTerminal=false\nX-KDE-GlobalAccel-CommandShortcut=true\n"
                "X-KDE-Shortcuts=%s\n" % (config, cmd, cmd,
                                          ",".join(k.replace(",", "\\,") for k in keys_of(keys))))
    change("services][" + name, "_launch", join(keys_of(keys), False))

os.makedirs(os.path.dirname(state), exist_ok=True)
json.dump(saved, open(state, "w"))
open(rc, "w").write("\n".join(lines))
PY
[[ -n "${shortcuts_changed:-}" ]] && command -v kbuildsycoca6 >/dev/null \
    && kbuildsycoca6 --noincremental >/dev/null 2>&1

# ---------------------------------------------------------------------------
# Compositor
# ---------------------------------------------------------------------------
# Naming the socket removes the usual guessing game: the alternative is to diff
# $XDG_RUNTIME_DIR before and after, which finds nothing when a previous
# session left a socket behind and the new one reuses that name.
export WAYLAND_DISPLAY="$CONFIG-$$"

# KWin's default task switcher layout is org.kde.breeze.desktop, which kwin
# itself does not ship and which is often not installed at all. A TabBox whose
# layout is missing draws nothing, so Alt+Tab looks broken rather than absent.
# Point it at one that exists, before the compositor reads its config.
layout="$(kreadconfig6 --file kwinrc --group TabBox --key LayoutName 2>/dev/null)"
if [[ -z "$layout" || ! -d "/usr/share/kwin/tabbox/$layout" ]]; then
    for candidate in /usr/share/kwin/tabbox/*/metadata.json; do
        [[ -e "$candidate" ]] || break
        kwriteconfig6 --file kwinrc --group TabBox --key LayoutName \
            "$(basename "$(dirname "$candidate")")" 2>/dev/null
        break
    done
fi

# Some compositors embed kglobalacceld and claim org.kde.kglobalaccel; a
# standalone daemon left over from a Plasma session makes that registration
# fail and takes every shortcut down with it.
systemctl --user stop plasma-kglobalaccel.service 2>/dev/null
pkill -x kglobalacceld 2>/dev/null
# The name can also still belong to the compositor of the session that just
# ended, which takes a moment to exit. KWin tries to register it once, at
# startup, and on failure runs with no global shortcuts at all -- every Super
# key dead until the next login. So wait for the name to be free.
for _ in $(seq 1 40); do
    busctl --user status org.kde.kglobalaccel >/dev/null 2>&1 || break
    sleep 0.25
done

# The display manager forks this script before logind has finished registering
# the login session, so a compositor started right away is left outside
# session-N.scope. logind then answers GetSessionByPID for kwin_wayland with
# "no such session", KWin falls back to a session backend that has no seat and
# therefore no terminal control, and Ctrl+Alt+F<n> silently stops switching
# terminals for the rest of the login. Everything else still works, which is
# what makes it hard to spot.
#
# Waiting on GetSessionByPID is not enough, and that is how this shipped
# broken: logind answers that call from the audit session id before it has
# moved the process into session-N.scope, so the wait returned immediately and
# the compositor was still forked into the old cgroup. A child inherits the
# cgroup it was forked in, which is why every later child -- the shell, the
# tray proxy -- ended up inside the scope and only the compositor stayed out.
# The cgroup is the thing logind actually resolves sessions from, so wait for
# that and nothing else.
for _ in $(seq 1 100); do
    grep -q 'session-.*\.scope' /proc/self/cgroup && break
    sleep 0.1
done
grep -q 'session-.*\.scope' /proc/self/cgroup \
    || echo "start-mmsimpulse: still outside session scope; Ctrl+Alt+F<n> will not switch terminals" >&2

# `env -u`, because kwin_wayland picks its backend from the environment: with
# WAYLAND_DISPLAY set it nests inside a parent compositor instead of taking
# the DRM device, and a login session then renders to nothing at all.
env -u WAYLAND_DISPLAY kwin_wayland --xwayland --socket "$WAYLAND_DISPLAY" \
    >"$HOME/.local/share/$CONFIG-compositor.log" 2>&1 &
KWIN_PID=$!
trap 'kill "$KWIN_PID" 2>/dev/null' EXIT

for _ in $(seq 1 40); do
    [[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$WAYLAND_DISPLAY" ]] && break
    sleep 0.25
done
[[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$WAYLAND_DISPLAY" ]] || {
    echo "compositor did not create its Wayland socket; aborting" >&2
    exit 1
}

# KWin creates the X socket immediately but only spawns Xwayland when a client
# first connects. Nothing in this session is an X client, so at this point there
# is no Xwayland to ask, and DISPLAY would stay unset for the whole session —
# every X11 program then dies with "Unable to open a connection to X".
# mmsimpulse-xdisplay reads the display straight out of the X lock file the
# compositor wrote, so no Xwayland has to be running yet.
DISPLAY="$(mmsimpulse-xdisplay "$KWIN_PID")" && export DISPLAY
[[ -n "${DISPLAY:-}" ]] || echo "Warning: no Xwayland display found; X11 clients will fail" >&2

# ---------------------------------------------------------------------------
# Services the shell depends on
# ---------------------------------------------------------------------------
# Publish the session environment so D-Bus and systemd activated services start
# with WAYLAND_DISPLAY and DISPLAY set instead of crashing on launch.
dbus-update-activation-environment --systemd --all 2>/dev/null

# The shell draws a fixed row of workspaces, but a KWin that has never been
# configured has exactly one virtual desktop, so on a fresh install every
# workspace past the first leads nowhere and Meta+2..0 do nothing. Top the
# count up to what the shell is drawing; KWin remembers them afterwards.
VD=org.kde.KWin.VirtualDesktopManager
for _ in $(seq 1 40); do
    busctl --user status org.kde.KWin >/dev/null 2>&1 && break
    sleep 0.25
done
want="$(jq -r '.bar.workspaces.shown // 10' "$HOME/.config/$CONFIG/config.json" 2>/dev/null)"
[[ "$want" =~ ^[0-9]+$ ]] || want=10
have="$(busctl --user get-property org.kde.KWin /VirtualDesktopManager "$VD" count 2>/dev/null | awk '{print $2}')"
while [[ "${have:-}" =~ ^[0-9]+$ ]] && (( have < want )); do
    busctl --user call org.kde.KWin /VirtualDesktopManager "$VD" createDesktop us "$have" "" \
        >/dev/null 2>&1 || break
    have=$((have + 1))
done

# Without a service cache, System Settings finds no KCMs and kglobalacceld
# finds none of the shortcut entries.
command -v kbuildsycoca6 >/dev/null && kbuildsycoca6 --noincremental 2>/dev/null

# Global shortcuts. A KWin fork may already embed the daemon and own the name,
# in which case starting another would fight it for the registration.
if ! busctl --user status org.kde.kglobalaccel >/dev/null 2>&1; then
    KGA="$(find_bin kglobalacceld)"
    [[ -n "$KGA" ]] && nohup "$KGA" >>"$LOG" 2>&1 &
fi

# Portals are D-Bus activated: asking for org.freedesktop.impl.portal.desktop.kde
# starts plasma-xdg-desktop-portal-kde.service on demand. Starting the binary by
# hand takes the bus name away from its unit, and then nothing restarts it when
# it exits — which looks exactly like the KDE backend refusing to autostart.
#
# First a clean slate now that the environment above is published, so the
# portals start with WAYLAND_DISPLAY and XDG_CURRENT_DESKTOP of this session
# instead of a previous one's. Done before kded6 and the shell start, which
# are the first to ask for a portal.
systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gtk.service \
    xdg-desktop-portal-hyprland.service xdg-desktop-portal-wlr.service \
    plasma-xdg-desktop-portal-kde.service 2>/dev/null
# Matched by path: the comm name is truncated to 15 characters, so `pkill -x`
# never matches these and the stale process keeps the bus name — which is what
# stops the unit from starting.
pkill -f '/xdg-desktop-portal-hyprland$' 2>/dev/null
pkill -f '/xdg-desktop-portal-wlr$' 2>/dev/null
pkill -f '/xdg-desktop-portal-kde$' 2>/dev/null
# Then the KDE backend is started through its unit. The services of the
# session that just ended restart with its stale environment while this one
# comes up, and an activation of the backend asked for then can be left
# pending in the bus for good: no start job, no error, and every portal call
# afterwards waits 25 seconds for nothing, so each GTK, Qt or Electron app
# takes that long to open. The bus settles a pending activation as soon as
# the name gets an owner, which starting the unit gives it.
timeout 15 systemctl --user start plasma-xdg-desktop-portal-kde.service 2>/dev/null

# Plasma starts kded6 itself; here nothing did. Its modules are what answer
# BlueZ and NetworkManager when they need the user: without the bluedevil agent
# a new Bluetooth device drops the moment it tries to pair ("Authentication
# attempt without agent"), and without the networkmanagement agent nothing asks
# for a Wi-Fi password. The media keys (its mediacontrol component) were dead
# too. Through its unit, so it is restarted if it crashes. kded6 also claims
# the tray's org.kde.StatusNotifierWatcher; the shell takes that back when it
# starts (see ConflictKiller in overlay/patch-shell.py).
systemctl --user start plasma-kded6.service 2>/dev/null

# Without plasmashell there is no Klipper, so whatever a program copies is
# gone the moment that program exits -- Spectacle's Copy button, a terminal
# closed after copying, and so on. wl-clip-persist takes the content over.
if command -v wl-clip-persist >/dev/null && ! pgrep -x wl-clip-persist >/dev/null; then
    nohup wl-clip-persist --clipboard regular >>"$LOG" 2>&1 &
fi

# Wine programs — Wallpaper Engine among them — still put their tray icon in
# the X11 XEmbed tray, which no Wayland bar can show: the bar speaks
# StatusNotifierItem. Plasma bridges the two with this proxy, and with no
# plasmashell here nothing starts it, so minimising such a program drops it off
# the desktop entirely with no way to get it back.
if command -v xembedsniproxy >/dev/null && ! pgrep -x xembedsniproxy >/dev/null; then
    nohup xembedsniproxy >>"$LOG" 2>&1 &
fi


# Power management: idle timeouts, DPMS, suspend, brightness. Optional — the
# session is usable without it, it just never dims or sleeps. A shell that
# does all of this itself says `powerdevil=off` in its profile: two of them
# would each dim, lock and suspend on their own timers.
UPOWERD="$(find_bin upowerd)"
[[ -n "$UPOWERD" ]] && nohup "$UPOWERD" >>"$LOG" 2>&1 &
POWERDEVIL="$(find_bin org_kde_powerdevil)"
[[ -n "$POWERDEVIL" && "$(profile powerdevil)" != off ]] && nohup "$POWERDEVIL" >>"$LOG" 2>&1 &

# cliphist only ever contains what a watcher hands it, and in a session with no
# desktop environment nothing else starts one: clipboard history stayed empty
# and the shell logged a failure every time it refreshed. Text and images are
# separate watches — one `wl-paste --watch` handles a single mime family.
if command -v cliphist >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
    pkill -f "wl-paste --type text --watch cliphist" 2>/dev/null
    pkill -f "wl-paste --type image --watch cliphist" 2>/dev/null
    wl-paste --type text --watch cliphist store >/dev/null 2>&1 &
    wl-paste --type image --watch cliphist store >/dev/null 2>&1 &
fi

# Our shell runs the KWin bridge itself (KwinBackend.qml) and reads the window
# list from it. The bridge is also what loads the KWin script, and with it the
# workspace pool across monitors and the Meta+1..0 keys, so for any other shell
# the session runs it.
[[ "$SHELL_CONFIG" != "$CONFIG" ]] && mmsimpulse-kwin-bridge >/dev/null 2>&1 &

# ---------------------------------------------------------------------------
# The shell, supervised
# ---------------------------------------------------------------------------
# `|| true` matters even without `set -e` here: it keeps a non-zero exit from
# ending the loop that exists to restart the shell.
(
    # Ending the session ends the shell with it.
    child=""
    trap 'kill "$child" 2>/dev/null; exit' TERM
    while true; do
        # Re-check DISPLAY on every start. Whatever the shell launches inherits
        # its environment, so a session that came up before Xwayland had a
        # display would hand every X11 program an empty DISPLAY for the rest of
        # its life — Minecraft and anything else on GLFW just exit. Resolving it
        # here means restarting the shell is enough to repair it.
        if [[ -z "${DISPLAY:-}" ]]; then
            DISPLAY="$(mmsimpulse-xdisplay "$KWIN_PID" 2>/dev/null)" || DISPLAY=""
            [[ -n "$DISPLAY" ]] && export DISPLAY \
                && dbus-update-activation-environment --systemd DISPLAY 2>/dev/null
        fi
        bash -c "exec $SHELL_CMD" >>"$LOG" 2>&1 &
        child=$!
        wait "$child"
        echo "$SHELL_CONFIG exited, restarting in 2s..." >&2
        sleep 2
    done
) &
SHELL_PID=$!

# An animated wallpaper is a player process, not a setting, so nothing brings it
# back on its own — not after a logout, and not after the compositor closes its
# surface, which is what happens when an RDP connection adds an output. This
# watches for both. Silent when no animated wallpaper was ever picked.
mmsimpulse-wallpaper supervise >/dev/null 2>&1 &

# The compositor exiting is what ends the session.
wait "$KWIN_PID"
kill "$SHELL_PID" 2>/dev/null
pkill -f "qs -c $SHELL_CONFIG" 2>/dev/null
trap - EXIT
