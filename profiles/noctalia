# Noctalia: https://github.com/noctalia-dev/noctalia
# Use it with: echo noctalia > ~/.config/mmsimpulse/shell
#
# Noctalia has a KWin backend of its own, so its workspaces and window list
# need nothing from here. The format is described in profiles/dux.
start=noctalia
bind Meta+Space=noctalia msg panel-toggle launcher
bind Meta+N=noctalia msg panel-toggle control-center
bind Meta+X=noctalia msg panel-toggle session
bind Meta+I=noctalia msg settings-toggle
bind Meta+B=noctalia msg bar-toggle
bind Meta+Shift+V=noctalia msg panel-toggle clipboard
bind Meta+,=noctalia msg panel-toggle wallpaper
