#!/usr/bin/env python3
"""Print the X display a KWin compositor serves, e.g. ":0".

KWin creates the X socket as soon as it starts but only spawns Xwayland when a
client first connects, so at session start there is no Xwayland process to ask
and DISPLAY would go unset for the whole session — X11 clients then fail with
"Unable to open a connection to X". Connecting to the socket is what makes KWin
spawn it, after which its argv names the display.

Usage: mmsimpulse-xdisplay <compositor-pid>
"""

import os
import re
import socket
import subprocess
import sys
import time

SOCKET_DIR = "/tmp/.X11-unix"


def compositor_sockets(pid):
    """X sockets this compositor is listening on, found through its open fds."""
    inodes = set()
    try:
        fds = os.listdir(f"/proc/{pid}/fd")
    except OSError:
        return []
    for fd in fds:
        try:
            match = re.fullmatch(r"socket:\[(\d+)\]", os.readlink(f"/proc/{pid}/fd/{fd}"))
        except OSError:
            continue
        if match:
            inodes.add(match.group(1))

    paths = []
    with open("/proc/net/unix") as unix:
        for line in unix:
            parts = line.split()
            if len(parts) >= 8 and parts[6] in inodes and parts[7].startswith(f"{SOCKET_DIR}/X"):
                paths.append(parts[7])
    return paths


def xwayland_display(pid):
    """The display in the compositor's Xwayland child's argv, if it has one."""
    try:
        children = subprocess.run(["pgrep", "-P", str(pid), "-x", "Xwayland"],
                                  capture_output=True, text=True).stdout.split()
    except OSError:
        return None
    for child in children:
        try:
            argv = open(f"/proc/{child}/cmdline", "rb").read().decode().split("\0")
        except OSError:
            continue
        for arg in argv:
            if re.fullmatch(r":\d+", arg):
                return arg
    return None


def main():
    if len(sys.argv) != 2:
        print("usage: mmsimpulse-xdisplay <compositor-pid>", file=sys.stderr)
        return 2
    pid = sys.argv[1]

    deadline = time.time() + 15
    while time.time() < deadline:
        display = xwayland_display(pid)
        if display:
            print(display)
            return 0
        # Nudge: a connection is what makes the compositor start Xwayland.
        for path in compositor_sockets(pid):
            probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                probe.connect(path)
            except OSError:
                pass
            finally:
                probe.close()
        time.sleep(0.25)

    print("no Xwayland display found", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
