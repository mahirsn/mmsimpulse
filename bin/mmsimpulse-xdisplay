#!/usr/bin/env python3
"""Print the X display a KWin compositor serves, e.g. ":0".

KWin creates the X socket as soon as it starts but only spawns Xwayland when a
client first connects, so at session start there is no Xwayland process to ask
and DISPLAY would go unset for the whole session — X11 clients then fail with
"Unable to open a connection to X".

/tmp/.X<N>-lock names the pid that reserved display :N, and for KWin that is
the compositor itself, so the answer needs no running Xwayland and no guessing.
Reading the compositor's open fds would work too, but stock Arch ships
kwin_wayland with cap_sys_nice, which makes /proc/<pid>/fd unreadable even to
the user running it — the lock file is world-readable everywhere.

Usage: mmsimpulse-xdisplay [compositor-pid]
"""

import os
import re
import sys
import time

SOCKET_DIR = "/tmp/.X11-unix"
LOCK = "/tmp/.X%s-lock"


def displays(pid=None):
    """Display numbers this compositor serves, lowest first."""
    found = []
    uid = os.getuid()
    try:
        names = os.listdir(SOCKET_DIR)
    except OSError:
        return found
    for name in names:
        match = re.fullmatch(r"X(\d+)", name)
        if not match:
            continue
        number = match.group(1)
        try:
            owner = open(LOCK % number).read().strip()
        except OSError:
            owner = None
        if pid is not None:
            if owner == str(pid):
                found.append(int(number))
            continue
        # No pid to match against: any socket of ours will do.
        try:
            if os.stat(os.path.join(SOCKET_DIR, name)).st_uid == uid:
                found.append(int(number))
        except OSError:
            continue
    return sorted(found)


def main():
    pid = sys.argv[1] if len(sys.argv) > 1 else None

    # The session script calls this straight after launching the compositor,
    # which may not have reserved a display yet.
    deadline = time.time() + 15
    while True:
        found = displays(pid)
        if found:
            print(":%d" % found[0])
            return 0
        if time.time() >= deadline:
            break
        time.sleep(0.25)
    print("no X display found", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
