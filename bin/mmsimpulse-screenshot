#!/usr/bin/env python3
"""Capture one output to a PNG, the way `grim -o <name> <file>` does.

grim speaks wlr-screencopy, which KWin does not implement, so it silently
produces nothing and every screenshot path downstream crops a file that was
never written. KWin's own org.kde.KWin.ScreenShot2 does the same job: it writes
raw pixels into a pipe and answers with their layout.

Stock KWin only lets a caller use ScreenShot2 if its executable has a desktop
entry declaring X-KDE-DBUS-Restricted-Interfaces, which a Python script can
never satisfy — its executable is the interpreter. Forks with the check relaxed
answer directly; everywhere else this falls back to spectacle, which is
declared, and crops its whole-workspace capture down to the wanted output.

Usage: mmsimpulse-screenshot <output-name> <file.png|-> [X,Y,W,H]

The optional geometry is the output's position and size in logical pixels; it
is what the fallback crops to, and callers already know it. Without it a
multi-monitor fallback returns the whole workspace.
"""

import json
import os
import subprocess
import sys
import tempfile

import dbus

SERVICE = "org.kde.KWin.ScreenShot2"
PATH = "/org/kde/KWin/ScreenShot2"

# QImage formats KWin hands back, mapped to how ImageMagick names the byte order.
FORMATS = {
    4: "bgra",   # RGB32, the alpha byte is unused
    5: "bgra",   # ARGB32
    6: "bgra",   # ARGB32_Premultiplied
    17: "rgba",  # RGBA8888
    18: "rgba",  # RGBA8888_Premultiplied
}


def outputs():
    """Enabled outputs with their logical position and scale."""
    try:
        raw = subprocess.run(["kscreen-doctor", "-j"], capture_output=True,
                             text=True, timeout=5).stdout
        return [o for o in json.loads(raw).get("outputs", []) if o.get("enabled")]
    except (OSError, ValueError, subprocess.SubprocessError):
        return []


def crop_args(output_name, geometry):
    """Where this output sits inside spectacle's whole-workspace capture.

    Not where the caller says it is. Spectacle renders every output at its own
    native size but positions them at the logical coordinate times the largest
    scale in use, so with one 1.0 and one 1.25 output the second one starts 480
    pixels further right than its logical x. Cropping at the logical
    coordinates then returns a picture of the wrong region — which is what a
    mixed-scale setup was getting.

    With a single scale, or a single output, this is the identity and the crop
    is exactly what it always was.
    """
    x, y, width, height = geometry
    outs = outputs()
    scales = [float(o.get("scale") or 1) for o in outs]
    mine = next((o for o in outs if o.get("name") == output_name), None)
    if not outs or mine is None:
        return ["-crop", "%dx%d+%d+%d" % (width, height, x, y), "+repage"]

    top = max(scales)
    scale = float(mine.get("scale") or 1)
    size = mine.get("size", {})
    native_w = int(size.get("width") or round(width * scale))
    native_h = int(size.get("height") or round(height * scale))
    args = ["-crop", "%dx%d+%d+%d" % (native_w, native_h,
                                      round(x * top), round(y * top)), "+repage"]
    # Callers ask for a picture of the output in logical pixels and size their
    # UI to it, so hand back that size rather than the panel's own.
    if (native_w, native_h) != (width, height):
        args += ["-resize", "%dx%d!" % (width, height)]
    return args


def spectacle_capture(output_name, target, geometry):
    """Whole workspace through spectacle, cropped to one output."""
    with tempfile.TemporaryDirectory() as tmp:
        shot = os.path.join(tmp, "workspace.png")
        grab = subprocess.run(["spectacle", "-b", "-n", "-f", "-o", shot],
                              capture_output=True)
        if grab.returncode or not os.path.exists(shot):
            sys.stderr.write(grab.stderr.decode()[:300] or "spectacle captured nothing\n")
            return 1
        out = "png:-" if target == "-" else "png:%s" % target
        argv = ["magick", shot]
        if geometry:
            argv += crop_args(output_name, geometry)
        argv.append(out)
        crop = subprocess.run(argv, capture_output=(target != "-"))
        if crop.returncode:
            if crop.stderr:
                sys.stderr.write(crop.stderr.decode()[:300])
            return 1
    return 0


def main():
    if len(sys.argv) not in (3, 4):
        print(next(l for l in __doc__.splitlines() if l.startswith("Usage:")),
              file=sys.stderr)
        return 2
    output_name, target = sys.argv[1], sys.argv[2]
    geometry = None
    if len(sys.argv) == 4:
        try:
            geometry = [int(round(float(n))) for n in sys.argv[3].split(",")]
        except ValueError:
            geometry = None
        if geometry is not None and len(geometry) != 4:
            geometry = None

    read_fd, write_fd = os.pipe()
    try:
        iface = dbus.Interface(dbus.SessionBus().get_object(SERVICE, PATH), SERVICE)
        result = iface.CaptureScreen(
            output_name, {"include-cursor": False},
            dbus.types.UnixFd(write_fd))
    except dbus.DBusException:
        os.close(read_fd)
        os.close(write_fd)
        return spectacle_capture(output_name, target, geometry)
    # The compositor holds its own copy now; ours has to go or the read blocks
    # forever waiting for an end that never comes.
    os.close(write_fd)

    width = int(result["width"])
    height = int(result["height"])
    stride = int(result["stride"])
    fmt = FORMATS.get(int(result["format"]))
    if fmt is None:
        os.close(read_fd)
        print(f"unsupported pixel format: {result['format']}", file=sys.stderr)
        return 1

    with os.fdopen(read_fd, "rb") as pipe:
        raw = pipe.read(stride * height)

    # Rows can be padded, and ImageMagick has no way to be told a stride.
    if stride != width * 4:
        raw = b"".join(raw[r * stride:r * stride + width * 4] for r in range(height))

    # Always PNG, and say so explicitly: callers pass names without an
    # extension, and ImageMagick picks its format from the extension. grim
    # writes PNG regardless, so matching it keeps those callers working.
    out = "png:-" if target == "-" else f"png:{target}"
    convert = subprocess.run(
        ["magick", "-size", f"{width}x{height}", "-depth", "8", f"{fmt}:-", out],
        input=raw, capture_output=(target != "-"))
    if convert.returncode:
        if convert.stderr:
            print(convert.stderr.decode()[:300], file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
