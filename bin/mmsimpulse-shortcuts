#!/usr/bin/env python3
"""The shell's keys as global shortcuts: the ones from the user's Hyprland or
niri config (mmsimpulse-binds), then the profile's.

  mmsimpulse-shortcuts <rc> <appdir> <state> <profile> <config>
      At login, before the compositor starts: its global shortcut daemon reads
      each entry once, when it registers it. The keys read from the config come
      in $MMSIMPULSE_IMPORTED. Exits 1 when there was nothing to do.

  mmsimpulse-shortcuts --watch <kwin pid> <binds source> <rc> <appdir> <state> <profile> <config>
      During the session: when the profile or a Hyprland or niri config is
      saved, the keys are bound again and handed to the running daemon, as
      Hyprland does on save.

Profile lines:
  bind <keys>=<command>    a new global shortcut that runs the command
  kwin <action>=<keys>     a KWin action, by its name in kglobalshortcutsrc

Whatever else holds such a key gives it up for the session. What was changed
is recorded and put back at the next login before the profile (or another
one) is applied again, so changing or dropping the profile leaves the keys
as they were.
"""

import glob
import json
import os
import re
import subprocess
import sys
import time

# A value is "active,default,friendly name"; [services] entries have only the
# active part, read as one string. Keys inside a part are split by a literal
# \t; a comma in a key is escaped, except in that one string.
split = lambda v: re.split(r"(?<!\\),", v)
keys_of = lambda part: [k.replace("\\,", ",") for k in part.split("\\t") if k and k != "none"]
MMS_MARK = "# mmsimpulse.lua"
join = lambda keys, esc=True: "\\t".join(k.replace(",", "\\,") if esc else k for k in keys) or "none"


def write(path, text):
    """Replace a file in one step: a crash or a power cut halfway leaves the old
    one, not an empty kglobalshortcutsrc."""
    path = os.path.realpath(path)
    tmp = "%s.mmsimpulse-%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    if os.path.exists(path):
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)
    os.replace(tmp, path)


def split_bind(text):
    """'Meta+)\\tMeta+==cmd' -> ('Meta+)\\tMeta+=', 'cmd'): '=' can be a key too."""
    for m in re.finditer("=", text):
        keys = text[:m.start()]
        if keys and all(k and (not k.endswith("+") or k.endswith("++")) for k in keys.split("\\t")):
            return keys.strip(), text[m.end():].strip()
    return None


def wanted(imported, profile):
    """(binds [(keys, command)], actions [(action, keys, add)]).

    The keys read from the user's Hyprland or niri config come first, the
    profile's after them; a key bound twice keeps the later binding. A KWin
    action from the config gets its keys added to the ones it has; a profile's
    sets them. mmsimpulse.lua (its lines start with MMS_MARK) comes after the
    profile instead, and says itself which of its actions add (`kwin+`).
    """
    prof = [(l, False) for l in (open(profile).read().splitlines() if profile else [])]
    if imported[:1] == [MMS_MARK]:
        entries = prof + [(l, None) for l in imported[1:]]
    else:
        entries = [(l, True) for l in imported] + prof
    bound, acts = {}, {}
    for line, add in entries:
        if line.startswith("bind ") and split_bind(line[5:]):
            keys, cmd = split_bind(line[5:])
            for name, (ks, a) in list(acts.items()):
                left = [k for k in ks if k != keys]
                if a and not left:
                    del acts[name]
                else:
                    acts[name] = (left, a)
            bound[keys] = cmd
        elif line.startswith("global ") and "=" in line and ":" in line.split("=", 1)[0]:
            # An action a shell registered (Hyprland's global shortcuts):
            # component:action, exactly these keys.
            name, keys = (x.strip() for x in line[7:].split("=", 1))
            comp, _, act = name.partition(":")
            ks = [k for k in keys.split("\\t") if k]
            for k in ks:
                bound.pop(k, None)
            acts["%s\x1f%s" % (comp, act)] = (ks, False)
        elif line.startswith(("kwin ", "kwin+ ")) and "=" in line:
            plus = line.startswith("kwin+ ")
            action, keys = (x.strip() for x in line[len("kwin+ " if plus else "kwin "):].split("=", 1))
            add = plus if add is None else add
            ks = [k for k in keys.split("\\t") if k]
            for k in ks:
                bound.pop(k, None)
            if add and action in acts:  # added to what an earlier line gave it
                ks = acts[action][0] + [k for k in ks if k not in acts[action][0]]
                add = acts[action][1]
            acts[action] = (ks, add)
    return (list(bound.items()),
            [(a, "\\t".join(ks) or "none", add) for a, (ks, add) in acts.items()])


def apply(rc, appdir, state, profile, config, imported, name_of):
    """Write the keys into kglobalshortcutsrc and the bind entries.

    name_of(keys, command) names each bind's entry. Returns the file's lines
    before and after, or None when there was nothing to do.
    """
    lines = open(rc).read().split("\n") if os.path.exists(rc) else []
    before = list(lines)
    saved = json.load(open(state)) if os.path.exists(state) else {}
    old_entries = glob.glob(os.path.join(appdir, config + "-bind-*.desktop"))
    binds, actions = wanted(imported, profile)
    if not saved and not old_entries and not binds and not actions:
        return None

    def find(group, key):
        """(index of the group header, index of the key's line or None)."""
        head, at = None, None
        for i, line in enumerate(lines):
            if line.startswith("["):
                if head is not None:
                    break
                if line == "[%s]" % group:
                    head = i
            elif head is not None and line.split("=", 1)[0] == key:
                at = i
        return head, at

    def get(group, key):
        _, at = find(group, key)
        return None if at is None else lines[at].split("=", 1)[1]

    def put(group, key, value):
        head, at = find(group, key)
        if value is None:
            if at is not None:
                del lines[at]
            return
        if at is not None:
            lines[at] = "%s=%s" % (key, value)
        elif head is not None:
            lines.insert(head + 1, "%s=%s" % (key, value))
        else:
            lines.extend(["", "[%s]" % group, "%s=%s" % (key, value)])

    def change(group, key, value):
        saved.setdefault("%s\x1f%s" % (group, key), get(group, key))
        put(group, key, value)

    # Put back what the last login changed. An entry that is gone since (an older
    # release's shell actions) has nothing to give the key back to.
    for gk, value in saved.items():
        group, key = gk.split("\x1f")
        gone = re.match(r"services\]\[(%s-.*\.desktop)$" % re.escape(config), group)
        if gone and not os.path.exists(os.path.join(appdir, gone.group(1))):
            continue
        put(group, key, value)
    saved = {}
    for path in old_entries:
        os.remove(path)
    lines[:] = [l for i, l in enumerate(lines)
                if not (l.startswith("[services][%s-bind-" % config) and
                        (i + 1 >= len(lines) or lines[i + 1].startswith("[") or not lines[i + 1]))]

    claimed = {k for keys, _ in binds for k in keys_of(keys)} | \
              {k for _, keys, _ in actions for k in keys_of(keys)}
    group = None
    for i, line in enumerate(list(lines)):
        if line.startswith("["):
            group = line[1:-1]
            continue
        if "=" not in line or line.startswith("_k_friendly_name"):
            continue
        key, value = line.split("=", 1)
        parts = [value] if group.startswith("services]") else split(value)
        held = keys_of(parts[0])
        if claimed & set(held):
            parts[0] = join([k for k in held if k not in claimed], not group.startswith("services]"))
            change(group, key, ",".join(parts))

    # An application entry bound to its own default key has no line in the file
    # (the daemon drops it), and takes that key again when it registers. Such an
    # entry gets an explicit binding without the claimed key.
    for name, held in default_keys(appdir).items():
        if name.startswith(config + "-bind-") or get("services][" + name, "_launch") is not None:
            continue
        if claimed & set(held):
            change("services][" + name, "_launch", join([k for k in held if k not in claimed], False))

    for action, keys, add in actions:
        comp, _, name = action.rpartition("\x1f")
        comp = comp or "kwin"
        parts = split(get(comp, name) or ",none,%s" % name)
        parts[0] = join(([k for k in keys_of(parts[0]) if k not in claimed] if add else []) +
                        [k for k in keys_of(keys) if not add or k not in keys_of(parts[0])])
        change(comp, name, ",".join(parts))

    written = set()
    for keys, cmd in binds:
        name = name_of(keys, cmd)
        written.add("[services][%s]" % name)
        with open(os.path.join(appdir, name), "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=%s: %s\nExec=%s\n"
                    "NoDisplay=true\nTerminal=false\nX-KDE-GlobalAccel-CommandShortcut=true\n"
                    "X-KDE-Shortcuts=%s\n" % (config, cmd, cmd,
                                              ",".join(k.replace(",", "\\,") for k in keys_of(keys))))
        change("services][" + name, "_launch", join(keys_of(keys), False))

    # A bind group left over from an entry that is gone (the daemon keeps it)
    # would give its keys to the next entry of that name.
    group, out = None, []
    for line in lines:
        if line.startswith("["):
            group = line
        if not (group and group.startswith("[services][%s-bind-" % config) and group not in written):
            out.append(line)
    lines[:] = out

    os.makedirs(os.path.dirname(state), exist_ok=True)
    write(state, json.dumps(saved))
    write(rc, "\n".join(lines))
    return before, lines


def default_keys(appdir):
    """{entry: its own keys} for the application entries that have keys."""
    dirs = [appdir] + [os.path.join(d, "applications") for d in
                       os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
    out = {}
    for d in dirs:
        for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
            name = os.path.basename(path)
            if name in out:
                continue
            try:
                text = open(path, errors="replace").read()
            except OSError:
                continue
            m = re.search(r"^X-KDE-Shortcuts=(.*)$", text, re.M)
            out[name] = [k.strip() for k in m.group(1).split(",") if k.strip()] if m else []
    return {n: ks for n, ks in out.items() if ks}


# ---------------------------------------------------------------------------
# Live
# ---------------------------------------------------------------------------

# Qt's key codes for the names kglobalshortcutsrc spells keys with
# (QKeySequence::PortableText), as the daemon takes them over D-Bus.
MODS = {"Meta": 0x10000000, "Ctrl": 0x04000000, "Alt": 0x08000000, "Shift": 0x02000000,
        "Num": 0x20000000}
NAMES = {"Esc": 0x01000000, "Tab": 0x01000001, "Backtab": 0x01000002, "Backspace": 0x01000003,
         "Return": 0x01000004, "Enter": 0x01000005, "Ins": 0x01000006, "Del": 0x01000007,
         "Pause": 0x01000008, "Print": 0x01000009, "SysReq": 0x0100000a, "Home": 0x01000010,
         "End": 0x01000011, "Left": 0x01000012, "Up": 0x01000013, "Right": 0x01000014,
         "Down": 0x01000015, "PgUp": 0x01000016, "PgDown": 0x01000017, "Space": 0x20,
         "Menu": 0x01000055, "Volume Down": 0x01000070, "Volume Mute": 0x01000071,
         "Volume Up": 0x01000072, "Media Play": 0x01000080, "Media Stop": 0x01000081,
         "Media Previous": 0x01000082, "Media Next": 0x01000083, "Media Pause": 0x01000085,
         "Toggle Media Play/Pause": 0x01000086, "Monitor Brightness Up": 0x010000b2,
         "Monitor Brightness Down": 0x010000b3, "Microphone Mute": 0x01000113,
         "Keyboard Light On/Off": 0x010000b4, "Keyboard Brightness Up": 0x010000b5,
         "Keyboard Brightness Down": 0x010000b6, "Power Off": 0x010000b7, "Screensaver": 0x010000ba,
         "Media Rewind": 0x010000c5, "Tools": 0x010000f1, "Battery": 0x010000fe,
         "Media Fast Forward": 0x01000102, "Hibernate": 0x01000108, "Power Down": 0x0100010b,
         "Microphone Volume Up": 0x0100011d, "Microphone Volume Down": 0x0100011e, "Sleep": 0x01020004}
NAMES.update({"F%d" % n: 0x01000030 + n - 1 for n in range(1, 36)})
NAMES.update({"Launch (%s)" % c: 0x010000a2 + i for i, c in enumerate("0123456789ABCDEF")})


def code(key):
    """Qt's code for 'Meta+Shift+Left', or None for a name not in NAMES."""
    mods, name = (key[:-2].split("+"), "+") if key.endswith("++") else \
        (key.split("+")[:-1], key.split("+")[-1])
    if any(m not in MODS for m in mods):
        return None
    if name in NAMES:
        k = NAMES[name]
    elif len(name) == 1 and 0x20 < ord(name) < 0x7f:
        k = ord(name.upper())
    else:
        return None
    return k | sum(MODS[m] for m in mods)


def parse(lines):
    """{(group, key): active keys} of kglobalshortcutsrc lines."""
    out, group = {}, None
    for line in lines:
        if line.startswith("["):
            group = line[1:-1]
        elif group and "=" in line and not line.startswith("_k_friendly_name"):
            key, value = line.split("=", 1)
            out[(group, key)] = keys_of(value if group.startswith("services]") else split(value)[0])
    return out


def push(before, after, config, log):
    """Hand what changed between two versions of the file to the daemon.

    A bind entry is a new entry: the daemon picks up added and removed
    application entries when the service cache changes (refreshServices),
    with the keys the entry's file gives. It reads an entry's command only
    then, so a bind whose command changed has a name not used before in the
    session. Registering one over D-Bus (doRegister) gives its key two
    shortcuts, one of which the daemon loses track of: the next press of the
    key after the entry is gone crashes KWin. The other entries, which only
    lose or get back keys, are told their keys.
    """
    import dbus
    accel = dbus.Interface(dbus.SessionBus().get_object("org.kde.kglobalaccel", "/kglobalaccel"),
                           "org.kde.KGlobalAccel")
    old, new = parse(before), parse(after)
    is_bind = lambda gk: gk[0].startswith("services][%s-bind-" % config)
    ident = lambda gk: [gk[0][len("services]["):], gk[1]] * 2 if gk[0].startswith("services][") \
        else [gk[0], gk[1]] * 2

    def bind(gk):
        if gk not in new:  # no line again: back to its own keys
            accel.setForeignShortcutKeys(dbus.Array(ident(gk), "s"), accel.defaultShortcutKeys(ident(gk)))
            return
        seqs = []
        for k in new[gk]:
            c = code(k)
            if c is None:
                print("mmsimpulse-shortcuts: no key code for %r; it is bound at the next login" % k, file=log)
                return
            seqs.append(dbus.Struct((dbus.Array([c, 0, 0, 0], "i"),)))
        accel.setForeignShortcutKeys(dbus.Array(ident(gk), "s"), dbus.Array(seqs, "(ai)"))

    others = [gk for gk in set(old) | set(new) if not is_bind(gk) and old.get(gk) != new.get(gk)]
    binds = {gk[0][len("services]["):] for gk in set(old) ^ set(new) if is_bind(gk)}
    for gk in others:
        bind(gk)
    if binds:
        subprocess.run(["kbuildsycoca6"], capture_output=True)
        # The daemon refreshes on its own, in a second or two.
        path = lambda n: "/component/" + re.sub(r"[^A-Za-z0-9]", "_", n)
        for _ in range(40):
            have = {str(c) for c in accel.allComponents()}
            if all((path(n) in have) == (("services][" + n, "_launch") in new) for n in binds):
                break
            time.sleep(0.25)
        else:
            print("mmsimpulse-shortcuts: the shortcut daemon did not pick up the new keys", file=log)
    # Once more now that the removed binds have let go of their keys.
    for gk in others:
        bind(gk)


# ---------------------------------------------------------------------------
# Settings: input and monitors, written into KWin's own configuration
# ---------------------------------------------------------------------------

# A setting kept in a config file: (file, group, key, value as the file has it,
# the effect to reload after it, if the file alone does not do it). None as
# a value leaves the key as KWin's default.
FOCUS = lambda v: "FocusFollowsMouse" if str(v) == "1" else "ClickToFocus"
BOOL = lambda v: "true" if v in (True, 1, "true", "1", "yes") else "false"
BORDERS = [(0, "None"), (2, "Tiny"), (4, "Normal"), (6, "Large"), (9, "VeryLarge"), (13, "Huge"),
           (19, "VeryHuge")]
BORDER = lambda v: v if isinstance(v, str) and not v.isdigit() else \
    next((n for px, n in BORDERS if int(v) <= px), "Oversized")
CORNERS = "kwin4_effect_shapecorners"
FILE_KEYS = {
    "input.kb_layout": ("kxkbrc", "Layout", "LayoutList", str, None),
    "input.kb_variant": ("kxkbrc", "Layout", "VariantList", str, None),
    "input.kb_model": ("kxkbrc", "Layout", "Model", str, None),
    "input.kb_options": ("kxkbrc", "Layout", "Options", str, None),
    "input.repeat_rate": ("kcminputrc", "Keyboard", "RepeatRate", str, None),
    "input.repeat_delay": ("kcminputrc", "Keyboard", "RepeatDelay", str, None),
    "input.follow_mouse": ("kwinrc", "Windows", "FocusPolicy", FOCUS, None),
    "general.border_size": ("kwinrc", "org.kde.kdecoration2", "BorderSize", BORDER, None),
    "general.allow_tearing": ("kwinrc", "Compositing", "AllowTearing", BOOL, None),
    "decoration.blur.enabled": ("kwinrc", "Plugins", "blurEnabled", BOOL, None),
    "decoration.dim_inactive": ("kwinrc", "Plugins", "diminactiveEnabled", BOOL, None),
    "decoration.dim_strength": ("kwinrc", "Effect-diminactive", "Strength",
                                lambda v: str(round(float(v) * 100)), "diminactive"),
    "decoration.rounding": ("kwinrc", "Round-Corners", "Size", lambda v: str(int(v)), CORNERS),
    "decoration.rounding.inactive": ("kwinrc", "Round-Corners", "InactiveCornerRadius",
                                     lambda v: str(int(v)), CORNERS),
    "misc.focus_on_activate": ("kwinrc", "Windows", "FocusStealingPreventionLevel",
                               lambda v: "0" if BOOL(v) == "true" else None, None),
    "animations.enabled": ("kdeglobals", "KDE", "AnimationDurationFactor",
                           lambda v: None if BOOL(v) == "true" else "0", None),
    "animations.duration": ("kdeglobals", "KDE", "AnimationDurationFactor", lambda v: "%g" % float(v), None),
}
# Read elsewhere: the window rules, and the pointing devices below.
RULE_KEYS = {"decoration.active_opacity", "decoration.inactive_opacity"}
# Hyprland's animation tree, the part KWin windows, layers and workspaces have: a leaf
# without its own hl.animation takes its parent's, and global defaults to
# Hyprland's own (on, speed 8, the default curve).
ANIMATIONS = "mmsimpulse_animations"
ANIM_PARENT = {"windows": "global", "windowsIn": "windows", "windowsOut": "windows",
               "layers": "global", "layersIn": "layers", "layersOut": "layers",
               "fade": "global", "fadeIn": "fade", "fadeOut": "fade", "fadeLayers": "fade",
               "fadeLayersIn": "fadeLayers", "fadeLayersOut": "fadeLayers",
               "workspaces": "global", "workspacesIn": "workspaces", "workspacesOut": "workspaces"}
ANIM_KEYS = {"windowsIn": "WindowsIn", "windowsOut": "WindowsOut", "fadeIn": "FadeIn", "fadeOut": "FadeOut",
             "layersIn": "LayersIn", "layersOut": "LayersOut",
             "fadeLayersIn": "FadeLayersIn", "fadeLayersOut": "FadeLayersOut",
             "workspacesIn": "WorkspacesIn", "workspacesOut": "WorkspacesOut"}
# Shell panels stay the shell's to animate unless the config names layers.
ANIM_LAYERS = {"layers", "layersIn", "layersOut", "fadeLayers", "fadeLayersIn", "fadeLayersOut"}


def animation_keys(sets, log):
    """kwinrc values that turn on and set mmsimpulse's animation effect."""
    nodes = {k[10:]: v for k, v in sets.items() if k.startswith("animation.") and isinstance(v, dict)}
    if not nodes:
        return {}
    curves = {"default": [0, 0.75, 0.15, 1], "linear": [0, 0, 1, 1]}
    for key, value in sets.items():
        if not key.startswith("curve."):
            continue
        try:
            (x1, y1), (x2, y2) = value["points"]
            curves[key[6:]] = [float(x1), float(y1), float(x2), float(y2)]
        except (TypeError, KeyError, ValueError):
            print("mmsimpulse-shortcuts: %s is not a bezier curve (springs are not animated); "
                  "the default curve is used" % key, file=log)
    for name in nodes:
        if name != "global" and name not in ANIM_PARENT:
            print("mmsimpulse-shortcuts: animation.%s is not animated on KWin; left out" % name, file=log)
    group = "kwinrc\x1fEffect-" + ANIMATIONS + "\x1f"
    # The effect switches workspaces in place of KWin's Slide.
    want = {"kwinrc\x1fPlugins\x1f%sEnabled" % ANIMATIONS: "true", "kwinrc\x1fPlugins\x1fslideEnabled": "false",
            group + "Layers": "true" if ANIM_LAYERS & set(nodes) else "false"}
    for leaf, key in ANIM_KEYS.items():
        node = leaf
        while node not in nodes and node != "global":
            node = ANIM_PARENT[node]
        t = nodes.get(node, {})
        on = BOOL(t.get("enabled", True)) == "true"
        curve = curves.get(t.get("bezier", "default")) if on else curves["default"]
        if curve is None:
            print("mmsimpulse-shortcuts: animation.%s: no curve %r; the default curve is used"
                  % (node, t.get("bezier")), file=log)
            curve = curves["default"]
        try:
            speed = float(t.get("speed", 8)) if on else 1.0
        except (TypeError, ValueError):
            speed = 8.0
        style = str(t.get("style", "")) if on else ""
        want[group + key] = " ".join(["1" if on else "0"] + ["%g" % x for x in [speed] + curve] + [style]).strip()
    return want


# input.<key> of each pointing device, through KWin's InputDevice objects:
# (property, D-Bus type, value, property that says the device has it,
#  property with the device's own default).
DEVICE_KEYS = {
    "sensitivity": [("pointerAcceleration", "d", float, "supportsPointerAcceleration", "defaultPointerAcceleration")],
    "accel_profile": [("pointerAccelerationProfileFlat", "b", lambda v: v == "flat",
                       "supportsPointerAccelerationProfileFlat", "defaultPointerAccelerationProfileFlat"),
                      ("pointerAccelerationProfileAdaptive", "b", lambda v: v != "flat",
                       "supportsPointerAccelerationProfileAdaptive", "defaultPointerAccelerationProfileAdaptive")],
    "natural_scroll": [("naturalScroll", "b", bool, "supportsNaturalScroll", "naturalScrollEnabledByDefault")],
    "left_handed": [("leftHanded", "b", bool, "supportsLeftHanded", "leftHandedEnabledByDefault")],
    "scroll_factor": [("scrollFactor", "d", float, None, None)],
    "tap-to-click": [("tapToClick", "b", bool, "tapFingerCount", "tapToClickEnabledByDefault")],
    "disable_while_typing": [("disableWhileTyping", "b", bool, "supportsDisableWhileTyping",
                              "disableWhileTypingEnabledByDefault")],
}


def groups(group):
    """kwriteconfig6's --group arguments; "AC][Display" is the group [AC][Display]."""
    return [a for g in group.split("][") for a in ("--group", g)]


def kconfig(file, group, key, value):
    """Write (None: delete) a KDE config value, telling KWin, which reloads it."""
    cmd = ["kwriteconfig6", "--notify", "--file", file, *groups(group), "--key", key]
    subprocess.run(cmd + (["--delete"] if value is None else [value]), capture_output=True)


def kread(file, group, key):
    res = subprocess.run(["kreadconfig6", "--file", file, *groups(group), "--key", key],
                         capture_output=True, text=True)
    return res.stdout.rstrip("\n") if res.stdout.strip() else None


# mms.power: PowerDevil's profiles. Its PowerButtonAction values; "screen-off"
# only turns the screens off, and the lid does nothing with an external monitor
# connected (PowerDevil's InhibitLidActionWhenExternalMonitorPresent).
LID = {"nothing": 0, "sleep": 1, "suspend": 1, "hibernate": 2, "shutdown": 8, "lock": 32,
       "screen-off": 64}
POWER_PROFILES = {"ac": "AC", "battery": "Battery", "lowbattery": "LowBattery"}
# when idle: (group, the on/off key or action, the timeout key, the "on" value)
POWER_IDLE = {"sleep": ("SuspendAndShutdown", "AutoSuspendAction", "AutoSuspendIdleTimeoutSec", "1"),
              "dim": ("Display", "DimDisplayWhenIdle", "DimDisplayIdleTimeoutSec", "true"),
              "screen_off": ("Display", "TurnOffDisplayWhenIdle", "TurnOffDisplayIdleTimeoutSec", "true")}
POWER_OFF = {"AutoSuspendAction": "0", "DimDisplayWhenIdle": "false", "TurnOffDisplayWhenIdle": "false"}


def power_keys(sets, log):
    """powerdevilrc values of the power.* settings.

    A shell that sleeps and dims on its own (MMSIMPULSE_SHELL_POWER, from its
    profile's powerdevil=off) keeps doing so: PowerDevil gets only the lid.
    """
    if not any(k.startswith("power.") for k in sets):
        return {}
    shell_power = os.environ.get("MMSIMPULSE_SHELL_POWER") == "1"
    out = {}
    for name, profile in POWER_PROFILES.items():
        get = lambda k: sets.get("power.%s.%s" % (name, k), sets.get("power." + k))
        lid = get("lid")
        if lid is not None:
            if str(lid) in LID:
                out["powerdevilrc\x1f%s][SuspendAndShutdown\x1fLidAction" % profile] = str(LID[str(lid)])
            else:
                print("mmsimpulse-shortcuts: power.lid = %r is not one of %s" % (lid, ", ".join(LID)), file=log)
        for key, (group, switch, timeout, on) in POWER_IDLE.items():
            value = None if shell_power else get(key)
            if value is None and not shell_power:
                continue
            g = "powerdevilrc\x1f%s][%s\x1f" % (profile, group)
            if value is None or value is False or value == 0 or value in ("false", "off", "no"):
                out[g + switch] = POWER_OFF[switch]
            elif isinstance(value, (int, float)) and not isinstance(value, bool) and value > 0:
                out[g + timeout] = str(int(value * 60))
                out[g + switch] = on
            else:
                print("mmsimpulse-shortcuts: power.%s = %r is not minutes or false" % (key, value), file=log)
    return out


def apply_settings(lines, state, log):
    """Apply `set input.*` and `monitor` lines; what was dropped goes back."""
    sets = {}
    for line in lines:
        if line.startswith("set ") and "=" in line:
            key, value = line[4:].split("=", 1)
            try:
                sets[key] = json.loads(value)
            except ValueError:
                pass
    path = os.path.join(os.path.dirname(state), "settings.json")
    old = json.load(open(path)) if os.path.exists(path) else {"files": {}, "devices": []}

    # Config files: the value before the first change is kept, to put back.
    want, reconfigure, effects = {}, False, set()
    if "decoration.rounding" in sets:  # both corners, as Hyprland's one radius
        sets.setdefault("decoration.rounding.inactive", sets["decoration.rounding"])
    for key, value in sets.items():
        section, _, name = key.partition(".")
        if key == "animations.duration" and BOOL(sets.get("animations.enabled", True)) == "false":
            continue  # animations off wins
        if key in FILE_KEYS:
            f, g, k, conv, effect = FILE_KEYS[key]
            if effect == CORNERS and not glob.glob("/usr/lib*/qt6/plugins/kwin/effects/plugins/%s.so" % CORNERS):
                print("mmsimpulse-shortcuts: %s needs a rounded corners effect "
                      "(kwin-effect-rounded-corners); left out" % key, file=log)
                continue
            try:
                v = conv(value)
            except (TypeError, ValueError):
                print("mmsimpulse-shortcuts: %s = %r is not a value it takes" % (key, value), file=log)
                continue
            if v is not None:
                want["\x1f".join((f, g, k))] = v
            if effect:
                effects.add(effect)
        elif key not in RULE_KEYS and section not in ("animation", "curve", "power") \
                and not (section == "input" and name.split(".")[-1] in DEVICE_KEYS):
            print("mmsimpulse-shortcuts: %s has no KWin counterpart; left out" % key, file=log)
    want.update(animation_keys(sets, log))
    want.update(power_keys(sets, log))
    if any(k.startswith("kxkbrc") for k in want):
        want.setdefault("kxkbrc\x1fLayout\x1fUse", "true")
        if "kxkbrc\x1fLayout\x1fOptions" in want:
            want.setdefault("kxkbrc\x1fLayout\x1fResetOldOptions", "true")
    files = old["files"]
    reloads = {fk: e for f, g, k, _, e in FILE_KEYS.values() if e for fk in ["\x1f".join((f, g, k))]}
    power = False
    for fk in list(files):
        if fk not in want:
            kconfig(*fk.split("\x1f"), files.pop(fk))
            reconfigure |= fk.startswith("kwinrc")
            power |= fk.startswith("powerdevilrc")
            effects.add(ANIMATIONS if ANIMATIONS in fk else reloads.get(fk))
    for fk, value in want.items():
        f, g, k = fk.split("\x1f")
        if fk not in files:
            files[fk] = kread(f, g, k)
        if kread(f, g, k) != value:
            kconfig(f, g, k, value)
            reconfigure |= f == "kwinrc"
            power |= f == "powerdevilrc"
            if ANIMATIONS in fk:
                effects.add(ANIMATIONS)
    effects.discard(None)

    # Pointing devices: touchpad.<key> for touchpads, <key> for every one.
    dev_keys = {}
    for key, value in sets.items():
        name = key.split(".", 1)[1] if key.startswith("input.") else ""
        if name in DEVICE_KEYS:
            dev_keys[(name, False)] = value
        elif name.startswith("touchpad.") and name[9:] in DEVICE_KEYS:
            dev_keys[(name[9:], True)] = value
    try:
        import dbus
        bus = dbus.SessionBus()
        if apply_rules([json.loads(l[5:]) for l in lines if l.startswith("rule ")], sets, bus, log):
            reconfigure = True
        if reconfigure:
            bus.call_blocking("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure", "", [])
        if power and bus.name_has_owner("org.kde.Solid.PowerManagement"):
            for method in ("reparseConfiguration", "refreshStatus"):  # as its settings page does
                bus.call_blocking("org.kde.Solid.PowerManagement", "/org/kde/Solid/PowerManagement",
                                  "org.kde.Solid.PowerManagement", method, "", [])
        for e in effects:
            bus.call_blocking("org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "reconfigureEffect", "s", [e])
        names = dbus.Interface(bus.get_object("org.kde.KWin", "/org/kde/KWin/InputDevice"),
                               "org.freedesktop.DBus.Properties").Get(
            "org.kde.KWin.InputDeviceManager", "devicesSysNames")
        dropped = [n for n in old["devices"] if n not in {k for k, _ in dev_keys}]
        for sysname in names:
            props = dbus.Interface(bus.get_object("org.kde.KWin", "/org/kde/KWin/InputDevice/" + sysname),
                                   "org.freedesktop.DBus.Properties")
            get = lambda p: props.Get("org.kde.KWin.InputDevice", p)
            if not get("pointer"):
                continue
            touchpad = bool(get("touchpad"))
            for name in set(k for k, _ in dev_keys) | set(dropped):
                value = dev_keys.get((name, True)) if touchpad and (name, True) in dev_keys \
                    else dev_keys.get((name, False))
                for prop, sig, conv, supports, default in DEVICE_KEYS[name]:
                    if supports and not get(supports):
                        continue
                    if value is None:
                        if not default:
                            new = dbus.Double(1.0) if sig == "d" else None
                        else:
                            new = get(default)
                    else:
                        new = dbus.Double(conv(value)) if sig == "d" else dbus.Boolean(conv(value))
                    if new is not None and get(prop) != new:
                        props.Set("org.kde.KWin.InputDevice", prop, new)
        old["devices"] = sorted({k for k, _ in dev_keys})
    except Exception as exc:  # KWin not up yet, or a device that went away
        print("mmsimpulse-shortcuts: input devices: %s" % exc, file=log)

    os.makedirs(os.path.dirname(path), exist_ok=True)
    write(path, json.dumps(old))
    apply_monitors([json.loads(l[8:]) for l in lines if l.startswith("monitor ")], log)


# Window rules: Hyprland's match and what it sets, as KWin rules. Placement
# (where, how big, which workspace, states) applies when the window opens;
# looks and focus always.
MATCH = {"class": "wmclass", "initial_class": "wmclass", "title": "title", "initial_title": "title"}
APPLY, FORCE, REGEX = 3, 2, 3
MATCH_KEYS = {"wmclass", "wmclassmatch", "wmclasscomplete", "title", "titlematch", "types"}
DEFAULTS = {"excludefromcapture": "excludefromcapture=false", "noborder": "noborder=false",
            "acceptfocus": "acceptfocus=true", "opacityactive": "opacityactive=100",
            "opacityinactive": "opacityinactive=100"}
NORMAL_AND_DIALOG = 1 | 32


def pair(v, sep=" "):
    """'800 600', {800, 600} or {w=800, h=600} -> (800, 600), or None."""
    if isinstance(v, dict):
        v = [v.get(k) for k in ("x", "y")] if "x" in v else [v.get(k) for k in ("w", "h")] if "w" in v else list(v.values())
    if isinstance(v, str):
        v = v.replace(",", " ").split()
    try:
        a, b = (int(float(x)) for x in v)
        return a, b
    except (TypeError, ValueError):
        return None


def rule_body(r, desktops, log):
    """kwinrulesrc lines of one Hyprland rule, or None when KWin cannot match it."""
    name = r.get("name") or "rule"
    match = r.get("match") or {}
    if not isinstance(match, dict):
        match = {}
    other = [k for k in match if k not in MATCH]
    if other:
        print("mmsimpulse-shortcuts: window rule %r matches on %s, which KWin rules cannot; left out" %
              (name, ", ".join(other)), file=log)
        return None
    body = ["Description=mmsimpulse: %s" % name]
    for k, v in match.items():
        body += ["%s=%s" % (MATCH[k], v), "%smatch=%d" % (MATCH[k], REGEX)]
        if MATCH[k] == "wmclass":
            body.append("wmclasscomplete=false")
    if not match:
        body.append("types=%d" % NORMAL_AND_DIALOG)
    sets, skipped = [], []
    for k, v in r.items():
        if k in ("name", "match", "float"):
            continue  # every window floats here
        if k == "workspace":
            n = str(v).split()[0] if str(v).split() else ""
            if n.isdigit() and 0 < int(n) <= len(desktops):
                sets += ["desktops=%s" % desktops[int(n) - 1], "desktopsrule=%d" % APPLY]
            else:
                skipped.append(k)
        elif k == "pin" and v:
            sets += ["desktops=", "desktopsrule=%d" % APPLY]
        elif k in ("move", "size") and pair(v):
            sets += ["%s=%d,%d" % ((("position" if k == "move" else "size"),) + pair(v)),
                     "%srule=%d" % ("position" if k == "move" else "size", APPLY)]
        elif k == "center" and v:
            sets += ["placement=5", "placementrule=%d" % FORCE]
        elif k == "opacity":
            parts = str(v).split()
            try:
                a = float(parts[0])
                i = float(parts[1]) if len(parts) > 1 else a
                sets += ["opacityactive=%d" % round(a * 100), "opacityactiverule=%d" % FORCE,
                         "opacityinactive=%d" % round(i * 100), "opacityinactiverule=%d" % FORCE]
            except (ValueError, IndexError):
                skipped.append(k)
        elif k == "no_focus" and v:
            sets += ["acceptfocus=false", "acceptfocusrule=%d" % FORCE]
        elif k == "fullscreen" and v:
            sets += ["fullscreen=true", "fullscreenrule=%d" % APPLY]
        elif k == "maximize" and v:
            sets += ["maximizehoriz=true", "maximizehorizrule=%d" % APPLY,
                     "maximizevert=true", "maximizevertrule=%d" % APPLY]
        elif k == "no_screen_share" and v:
            sets += ["excludefromcapture=true", "excludefromcapturerule=%d" % FORCE]
        elif (k == "decorate" and not v) or (k == "border_size" and str(v) == "0"):
            sets += ["noborder=true", "noborderrule=%d" % FORCE]
        elif k == "above" and v:
            sets += ["above=true", "aboverule=%d" % APPLY]
        else:
            skipped.append(k)
    if skipped:
        print("mmsimpulse-shortcuts: window rule %r: %s has no KWin counterpart; left out" %
              (name, ", ".join(skipped)), file=log)
    return body + sets if sets else None


def apply_rules(rules, sets, bus, log):
    """Write mmsimpulse's rules into kwinrulesrc next to the user's own. True if it changed."""
    conf = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    path = os.path.join(conf, "kwinrulesrc")
    try:
        desktops = [str(d[1]) for d in sorted(bus.get_object("org.kde.KWin", "/VirtualDesktopManager").Get(
            "org.kde.KWin.VirtualDesktopManager", "desktops", dbus_interface="org.freedesktop.DBus.Properties"))]
    except Exception:
        desktops = []
    # KWin takes each property from the first rule that sets it, Hyprland
    # from the last: the rules go in backwards, and the opacity for every
    # window, the least specific, last.
    rules = list(reversed(rules))
    ops = [sets.get("decoration.active_opacity"), sets.get("decoration.inactive_opacity")]
    if any(o is not None and float(o) != 1.0 for o in ops):
        a, i = (1.0 if o is None else float(o) for o in ops)
        rules.append({"name": "decoration opacity", "opacity": "%g %g" % (a, i)})
    ours = [b for b in (rule_body(r, desktops, log) for r in rules) if b]
    groups, order, cur = {}, [], None
    old = open(path).read() if os.path.exists(path) else ""
    for line in old.splitlines():
        if line.startswith("[") and line.endswith("]"):
            cur = line[1:-1]
            groups[cur] = []
            order.append(cur)
        elif cur is not None and line.strip():
            groups[cur].append(line)
    # KWin 6.8 keeps the order as Order=; older files have rules= and count=,
    # which KWin turns into Order= itself.
    general = dict(l.split("=", 1) for l in groups.get("General", []) if "=" in l)
    listed = general.pop("Order", None) or general.pop("rules", "")
    general.pop("rules", None)
    general.pop("count", None)
    theirs = [g for g in listed.split(",") if g and not g.startswith("mmsimpulse-")]
    order = [g for g in order if not g.startswith("mmsimpulse-back-")]
    names = ["mmsimpulse-%d" % (n + 1) for n in range(len(ours))]
    general["Order"] = ",".join(theirs + names)
    out = ["[General]"] + ["%s=%s" % kv for kv in general.items()]
    for g in order:
        if g != "General" and not g.startswith("mmsimpulse-"):
            out += ["", "[%s]" % g] + groups[g]
    for g, body in zip(names, ours):
        out += ["", "[%s]" % g] + body

    def render(lines, extra=()):
        if not theirs and not names and not extra:
            return ""
        lines = list(lines)
        if extra:
            at = next(i for i, l in enumerate(lines) if l.startswith("Order="))
            lines[at] = "Order=" + ",".join(theirs + names + [g for g, _ in extra])
            for g, body in extra:
                lines += ["", "[%s]" % g] + body
        return "\n".join(lines) + "\n"

    text = render(out)
    if text == old:
        return False
    # KWin leaves a window as a removed "always" rule made it: hidden from
    # capture, borderless, see-through. So what is no longer forced is first
    # forced back to KWin's default, then the rule goes.
    # KWin 6.8 saves noborder as decorationpolicy, and sorts the lines.
    alias = {"decorationpolicy": "noborder"}

    def forced(bodies):
        out = set()
        for b in bodies:
            match = tuple(sorted(l for l in b if l.split("=", 1)[0] in MATCH_KEYS))
            for l in b:
                key = l.split("=", 1)[0]
                if (key in DEFAULTS or key in alias) and "%srule=%d" % (key, FORCE) in b:
                    out.add((match, alias.get(key, key)))
        return out
    dropped = forced(groups[g] for g in order if g.startswith("mmsimpulse-")) - forced(ours)
    if dropped:
        back = {}
        for match, key in sorted(dropped):
            # A border comes back only through "apply now" (measured).
            back.setdefault(match, []).extend([DEFAULTS[key], "%srule=%d" % (key, 5 if key == "noborder" else FORCE)])
        extra = [("mmsimpulse-back-%d" % (n + 1), ["Description=mmsimpulse: back to default"] + list(m) + b)
                 for n, (m, b) in enumerate(back.items())]
        write(path, render(out, extra))
        try:
            bus.call_blocking("org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure", "", [])
            time.sleep(0.5)
        except Exception as exc:
            print("mmsimpulse-shortcuts: window rules: %s" % exc, file=log)
    write(path, text)
    return True


def apply_monitors(monitors, log):
    """Hyprland's monitor tables through kscreen-doctor, changing only what differs."""
    if not monitors:
        return
    res = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True)
    try:
        outputs = {o["name"]: o for o in json.loads(res.stdout)["outputs"]}
    except (ValueError, KeyError):
        print("mmsimpulse-shortcuts: kscreen-doctor: %s" % res.stderr.strip(), file=log)
        return
    args, places = [], {}
    for m in monitors:
        name = str(m.get("output", ""))
        o = outputs.get(name)
        if not o:
            print("mmsimpulse-shortcuts: monitor %r is not connected" % name, file=log)
            continue
        out = "output.%s." % name
        mode = str(m.get("mode", "")).strip().lower()
        if m.get("disabled") or mode == "disable":
            if o["enabled"]:
                args.append(out + "disable")
            continue
        if not o["enabled"]:
            args.append(out + "enable")
        modes = o.get("modes", [])
        area = lambda x: x["size"]["width"] * x["size"]["height"]
        pick = None
        if mode in ("preferred", "") and o.get("preferredModes"):
            pick = o["preferredModes"][0] if mode else None
        elif mode == "highres":
            pick = max(modes, key=lambda x: (area(x), x["refreshRate"]))["id"]
        elif mode == "highrr":
            pick = max(modes, key=lambda x: (x["refreshRate"], area(x)))["id"]
        else:
            g = re.fullmatch(r"(\d+)x(\d+)(?:@([\d.]+)(?:hz)?)?", mode)
            same = [x for x in modes if g and (x["size"]["width"], x["size"]["height"]) == (int(g[1]), int(g[2]))]
            if same:
                rate = float(g[3]) if g[3] else max(x["refreshRate"] for x in same)
                best = min(same, key=lambda x: abs(x["refreshRate"] - rate))
                pick = best["id"]
                if abs(best["refreshRate"] - rate) > 0.5:
                    print("mmsimpulse-shortcuts: monitor %s has no %s; %s instead" % (name, mode, best["name"]),
                          file=log)
            elif mode:
                print("mmsimpulse-shortcuts: monitor %s has no mode %s" % (name, mode), file=log)
        if pick and str(pick) != str(o.get("currentModeId")):
            args.append(out + "mode." + str(pick))
        scale = m.get("scale")
        if isinstance(scale, (int, float)) and abs(float(scale) - float(o["scale"])) > 1e-3:
            args.append(out + "scale.%g" % float(scale))
        rot = {0: "none", 1: "left", 2: "inverted", 3: "right"}.get(m.get("transform", 0) if
                                                                    isinstance(m.get("transform", 0), int) else -1)
        if rot is None:
            print("mmsimpulse-shortcuts: monitor %s: transform %r has no KWin counterpart" %
                  (name, m.get("transform")), file=log)
        elif "transform" in m and {"none": 1, "left": 2, "inverted": 4, "right": 8}[rot] != o.get("rotation"):
            args.append(out + "rotation." + rot)
        pos = re.fullmatch(r"(-?\d+)x(-?\d+)", str(m.get("position", "")).strip())
        if pos:
            places[name] = (int(pos[1]), int(pos[2]))
    # KWin takes no negative positions; Hyprland's are relative anyway.
    if places:
        dx, dy = min(x for x, _ in places.values()), min(y for _, y in places.values())
        for name, (x, y) in places.items():
            if (x - dx, y - dy) != (outputs[name]["pos"]["x"], outputs[name]["pos"]["y"]):
                args.append("output.%s.position.%d,%d" % (name, x - dx, y - dy))
    if args:
        res = subprocess.run(["kscreen-doctor"] + args, capture_output=True, text=True)
        if res.returncode != 0 or "failed" in res.stdout + res.stderr:
            print("mmsimpulse-shortcuts: kscreen-doctor %s: %s" % (" ".join(args), (res.stdout + res.stderr).strip()),
                  file=log)


def watched(paths):
    """What the config files look like: their names and modification times."""
    out = []
    for p in paths:
        if os.path.isdir(p):
            for d, _, files in os.walk(p, followlinks=True):
                out += [os.path.join(d, f) for f in files]
        else:
            out.append(p)
    sig = []
    for f in sorted(out):
        try:
            sig.append((f, os.stat(f).st_mtime_ns))
        except OSError:
            pass
    return sig


class Once:
    """A log that says each line once: every save reads the whole config again."""

    def __init__(self, out):
        self.out, self.seen, self.part = out, set(), ""

    def write(self, text):
        self.part += text
        while "\n" in self.part:
            line, self.part = self.part.split("\n", 1)
            if line not in self.seen:
                self.seen.add(line)
                self.out.write(line + "\n")
                self.out.flush()

    def flush(self):
        pass


def notify(text):
    """Say so on screen, as Hyprland's error bar does."""
    try:
        subprocess.run(["notify-send", "-a", "mmsimpulse", "-u", "critical", "mmsimpulse: config error",
                        text[-500:] + "\nThe settings stay as they were."], capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


POWERDEVIL = ["/usr/lib/org_kde_powerdevil", "/usr/libexec/org_kde_powerdevil",
              "/usr/lib/x86_64-linux-gnu/libexec/org_kde_powerdevil"]


def powerdevil_running():
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            if os.path.basename(os.readlink("/proc/%s/exe" % pid)) == "org_kde_powerdevil":
                return True
        except OSError:
            pass
    return False


def watch(kwin, source, rc, appdir, state, profile, config):
    conf = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    # mmsimpulse.lua and what it requires, the profile, and the configs it
    # may source.
    paths = [p for p in (profile, os.path.join(conf, "mmsimpulse"),
                         os.path.join(conf, "hypr"), os.path.join(conf, "niri")) if p]
    binds_bin = os.path.join(os.path.dirname(os.path.realpath(__file__)), "mmsimpulse-binds")
    names = {}
    for path in glob.glob(os.path.join(appdir, config + "-bind-*.desktop")):
        text = open(path, errors="replace").read()
        cmd = re.search(r"^Exec=(.*)$", text, re.M)
        keys = re.search(r"^X-KDE-Shortcuts=(.*)$", text, re.M)
        if cmd and keys:
            ks = [k.replace("\\,", ",") for k in re.split(r"(?<!\\),", keys.group(1)) if k]
            names[(join(ks, False), cmd.group(1))] = os.path.basename(path)
    used = [int(m.group(1)) for n in names.values() for m in [re.search(r"-bind-(\d+)", n)] if m]
    counter = [max(used, default=0)]

    def name_of(keys, cmd):
        k = (join(keys_of(keys), False), cmd)
        if k not in names:
            counter[0] += 1
            names[k] = "%s-bind-%d.desktop" % (config, counter[0])
        return names[k]

    def devices():
        try:
            import dbus
            return list(dbus.Interface(dbus.SessionBus().get_object("org.kde.KWin", "/org/kde/KWin/InputDevice"),
                                       "org.freedesktop.DBus.Properties").Get(
                "org.kde.KWin.InputDeviceManager", "devicesSysNames"))
        except Exception:
            return None

    log = Once(sys.stderr)

    def settings(lines):
        try:
            apply_settings(lines, state, log)
        except Exception as exc:
            print("mmsimpulse-shortcuts: %s" % exc, file=sys.stderr)
        # mms.power added during the session, to a shell that keeps PowerDevil off
        if any(l.startswith("set power.") for l in lines) and not powerdevil_running():
            exe = next((p for p in POWERDEVIL if os.access(p, os.X_OK)), None)
            if exe:
                subprocess.Popen([exe], stdout=sys.stderr, stderr=sys.stderr, start_new_session=True)

    # The input and monitor settings, now that KWin is up.
    res = subprocess.run([binds_bin, source], capture_output=True, text=True)
    sys.stderr.write(res.stderr)
    current = res.stdout.splitlines()
    settings(current)
    last, seen = watched(paths), devices()
    while True:
        time.sleep(1)
        try:
            os.kill(kwin, 0)
        except OSError:
            return 0  # the session ended
        now = watched(paths)
        if now == last:
            plugged = devices()
            if plugged is not None and plugged != seen:  # a mouse plugged in gets them too
                seen = plugged
                settings(current)
            continue
        time.sleep(0.3)  # an editor saving in steps
        if watched(paths) != now:
            continue
        last = now
        res = subprocess.run([binds_bin, source], capture_output=True, text=True)
        sys.stderr.write(res.stderr)
        if res.returncode != 0:
            notify(res.stderr.strip())
            continue  # a config that does not read: keep the keys it had
        current = res.stdout.splitlines()
        try:
            done = apply(rc, appdir, state, profile, config, current, name_of)
            if done:
                push(*done, config, log)
        except Exception as exc:  # the session lives on; the next save tries again
            print("mmsimpulse-shortcuts: %s" % exc, file=sys.stderr)
        settings(current)


def main(argv):
    if argv[:1] == ["--watch"]:
        return watch(int(argv[1]), argv[2] or "auto", *argv[3:])
    rc, appdir, state, profile, config = argv
    imported = os.environ.get("MMSIMPULSE_IMPORTED", "").splitlines()
    n = iter(range(1, 10 ** 6))
    done = apply(rc, appdir, state, profile, config, imported,
                 lambda keys, cmd: "%s-bind-%d.desktop" % (config, next(n)))
    return 0 if done else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
