#!/usr/bin/env python3
"""mmsimpulse bridge between KWin and the Quickshell shell.

Why this exists: Quickshell has no D-Bus API in QML and owns no bus name, and
KWin publishes no window list on D-Bus. The only way to see windows is a KWin
script, whose only way out is callDBus(). So something has to own a bus name,
receive those pushes, and hand the result to the shell in a form Quickshell can
read. That is this process. It prints one JSON snapshot per line on stdout,
which KwinBackend.qml consumes exactly the way NiriBackend.qml consumes
`niri msg event-stream`.

Virtual desktops come straight off org.kde.KWin, which does expose them.

Nothing here knows about tiling. mmsimpulse runs with [Tiling] Enabled=false.
"""

import ctypes
import json
import os
import re
import signal
import socket
import subprocess
import sys
import tempfile
import time

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

BUS_NAME = "org.mmsimpulse.KWin"
OBJ_PATH = "/Windows"
KWIN = "org.kde.KWin"
VDM_IFACE = "org.kde.KWin.VirtualDesktopManager"
SCRIPT_NAME = "mmsimpulse-windows"
SCRIPT = os.environ.get(
    "MMSIMPULSE_KWIN_SCRIPT",
    os.path.expanduser("~/.local/share/mmsimpulse/kwin/mmsimpulse-windows.js"),
)
DEBOUNCE_MS = 60


# ---------------------------------------------------------------------------
# Pure helpers
# ---------------------------------------------------------------------------

def normalize_uuid(value):
    """KWin spells the same id both as {uuid} and uuid depending on the API.

    WindowsRunner.Run() wants the braced form that QUuid::toString() produces,
    while the script's QUuid->JS conversion is not guaranteed to keep braces.
    Normalising on both sides is what keeps focus/close pointing at the right
    window.
    """
    return "{" + str(value).strip("{}") + "}"


def build_snapshot(payload, desktops, current_id):
    """Merge the script's window push with virtual-desktop state.

    `desktops` is org.kde.KWin's a(iss) as [(position, id, name)] with a
    0-based position; the shell wants Hyprland-style 1-based numeric ids, so
    workspace N is position N-1.
    """
    by_uuid = {d[1]: int(d[0]) + 1 for d in desktops}
    workspaces = [
        {
            "id": int(pos) + 1,
            # `idx` and `output` mirror niri's shape, which is what the skin's
            # non-Hyprland code path reads. KWin's desktops are global, so no
            # workspace names an output.
            "idx": int(pos) + 1,
            "output": "",
            "uuid": uuid,
            "name": name or f"Desktop {int(pos) + 1}",
        }
        for pos, uuid, name in desktops
    ]
    workspaces.sort(key=lambda w: w["id"])
    current = by_uuid.get(current_id, workspaces[0]["id"] if workspaces else 1)
    for ws in workspaces:
        ws["is_active"] = ws["id"] == current

    # The bar asks a workspace whether anything on it is fullscreen. Hyprland
    # answers that per workspace and KWin does not, so it is worked out here --
    # without it the flag is undefined on KDE and the bar never notices.
    fullscreen_on = set()

    windows = []
    for w in payload.get("windows", []):
        on = [by_uuid[u] for u in w.get("desktops", []) if u in by_uuid]
        # An empty desktop list means "on all desktops", so such a window is
        # always on whichever one is current rather than on none.
        ws_id = on[0] if on else current
        ws_name = next((w2["name"] for w2 in workspaces if w2["id"] == ws_id), "")
        windows.append({
            **w,
            "id": normalize_uuid(w.get("id", "")),
            "address": normalize_uuid(w.get("id", "")),
            "class": w.get("appId", ""),
            "focused": w.get("active", False),
            "workspaceId": ws_id,
            "onAllDesktops": not on,
            # The overview reads windows in `hyprctl clients -j` shape, so
            # mirror it. `monitor` is an index and is filled in by
            # KwinBackend.qml, which is where the monitor list lives.
            "at": [w.get("x", 0), w.get("y", 0)],
            "size": [w.get("width", 0), w.get("height", 0)],
            "workspace": {"id": ws_id, "name": ws_name},
            # Tiling is off, so every window is floating by definition.
            "floating": True,
            "xwayland": False,
        })
        if w.get("fullscreen"):
            fullscreen_on.add(ws_id)

    # Named the way Hyprland names it, because the shell reads that name.
    for ws in workspaces:
        ws["hasfullscreen"] = ws["id"] in fullscreen_on

    # With PerOutputVirtualDesktops on, each output has its own current
    # desktop; without it they all report the global one.
    # Per output as well as per workspace: KWin's virtual desktops are global, so
    # the workspace flag is true on every monitor at once and a fullscreen game
    # on one screen would speak for the other.
    #
    # Maximised is reported apart from fullscreen: a fullscreen window covers the
    # bar, so it is the maximised one -- which stops at the bar and leaves a
    # gapped design showing desktop around it -- that the bar has to react to.
    #
    # Only what the output is showing counts. A maximised browser left on
    # another desktop, or minimised, kept the bar hugged everywhere.
    def shown(w, name, desk):
        if w.get("output", "") != name or w.get("minimized"):
            return False
        on = [by_uuid[u] for u in w.get("desktops", []) if u in by_uuid]
        return not on or desk in on

    outputs = []
    for o in payload.get("outputs", []):
        name = o.get("name", "")
        desk = by_uuid.get(o.get("currentDesktop", ""), current)
        here = [w for w in payload.get("windows", []) if shown(w, name, desk)]
        outputs.append({"name": name, "model": o.get("model", ""), "current": desk,
                        "hasfullscreen": any(w.get("fullscreen") for w in here),
                        "hasmaximized": any(w.get("maximized") for w in here)})

    return {
        "windows": windows,
        "workspaces": workspaces,
        "current": current,
        "outputs": outputs,
        "activeOutput": payload.get("activeOutput", ""),
        "pool": bool(payload.get("pool", False)),
        "cursorOutput": payload.get("cursorOutput", ""),
    }


# Focus and close have no D-Bus route: org.kde.KWin.WindowsRunner belongs to
# the krunner-integration plugin, which is not loaded in a plain KWin
# session, so calls to it fail with "No such interface". The KWin scripting API
# does expose both — activeWindow is writable and closeWindow is a public slot —
# and a loaded script cannot be called into, so each action runs as a throwaway
# script. Same trick kdotool uses.
ACTIONS = {
    "activate": "workspace.activeWindow = w;",
    "close": "w.closeWindow();",
    "minimize": "w.minimized = true;",
    "unminimize": "w.minimized = false;",
    "keepAbove": "w.keepAbove = !w.keepAbove;",
    "fullscreen": "w.fullScreen = !w.fullScreen;",
    # KWin's own actions work on the active window; these are its "Maximize
    # Window", "Center Window" and "Move Window to Next Screen".
    "maximize": "workspace.activeWindow = w; workspace.slotWindowMaximize();",
    "center": "workspace.activeWindow = w; workspace.slotWindowCenter();",
    "nextOutput": "workspace.activeWindow = w; workspace.slotWindowToNextScreen();",
    "pin": "w.onAllDesktops = !w.onAllDesktops;",
}


def desktop_script(output_name, position):
    """Switch one output to a 1-based desktop.

    org.kde.KWin.setCurrentDesktop is global. KWin's own setCurrent takes an
    output and, with [Windows] PerOutputVirtualDesktops on, moves only that
    one — and with it off still moves them all — so the per-output call is
    correct either way and no mode detection is needed.
    """
    return (
        "const want = %d;\n"
        "const outName = %s;\n"
        "const d = workspace.desktops.find(d => d.x11DesktopNumber === want);\n"
        "if (d) {\n"
        "    let target = null;\n"
        "    const screens = workspace.screens;\n"
        "    for (let i = 0; i < screens.length; i++) {\n"
        "        if (screens[i].name === outName) { target = screens[i]; break; }\n"
        "    }\n"
        "    if (target) workspace.setCurrentDesktopForScreen(d, target);\n"
        "    else workspace.currentDesktop = d;\n"
        "}\n" % (int(position), json.dumps(output_name))
    )


def move_active_script(position, follow):
    """Move the focused window to a desktop, optionally following it there.

    KWin's own "Window to Desktop N" moves without following, which is the
    Meta+Alt+N behaviour; this covers Meta+Shift+N, which Hyprland follows.
    Taking workspace.activeWindow here avoids having to know a window id.
    """
    return (
        "const want = %d;\n"
        "const d = workspace.desktops.find(d => d.x11DesktopNumber === want);\n"
        "const w = workspace.activeWindow;\n"
        "if (d && w) {\n"
        "    w.desktops = [d];\n"
        "    if (%s) workspace.setCurrentDesktopForScreen(d, w.output || workspace.activeScreen);\n"
        "}\n" % (int(position), "true" if follow else "false")
    )


# Hyprland resizes the active window by 100 px a step (Super+Alt+arrows); KWin's
# own grow/shrink actions jump to the next window edge instead.
RESIZE_STEP = 100
RESIZE = {"left": (-1, 0), "right": (1, 0), "up": (0, -1), "down": (0, 1)}


def resize_active_script(direction):
    dx, dy = (n * RESIZE_STEP for n in RESIZE[direction])
    return (
        "const w = workspace.activeWindow;\n"
        "if (w && w.resizeable && !w.fullScreen) {\n"
        "    const g = w.frameGeometry;\n"
        "    w.frameGeometry = { x: g.x, y: g.y, width: Math.max(g.width + %d, 100), height: Math.max(g.height + %d, 100) };\n"
        "}\n" % (dx, dy)
    )


def window_script(window_uuid, action, value=""):
    """One-shot KWin script source performing `action` on one window."""
    if action == "move":
        body = (
            "const d = workspace.desktops"
            ".find(d => d.x11DesktopNumber === %d);\n"
            "    if (d) w.desktops = [d];" % int(value)
        )
    elif action in ACTIONS:
        body = ACTIONS[action]
    else:
        raise ValueError(f"unknown window action: {action}")

    target = normalize_uuid(window_uuid).strip("{}")
    return (
        "const target = %s;\n"
        "const w = workspace.windowList()"
        ".find(w => String(w.internalId).replace(/[{}]/g, '') === target);\n"
        "if (w) {\n"
        "    %s\n"
        "}\n" % (json.dumps(target), body)
    )


# ---------------------------------------------------------------------------
# niri's IPC, for shells written for niri
# ---------------------------------------------------------------------------
# A shell that talks to niri (NIRI_SOCKET; digit, waybar's niri modules and
# the like) gets niri's socket here, answered from KWin's state: one JSON
# request per line, {"Ok": ...} or {"Err": ...} back, and an event stream.
#
# niri gives each monitor its own workspaces, mmsimpulse shares one pool of
# ten. So every monitor lists all ten, as the ext-workspace bridge does, and
# the one a monitor shows is its active one. Workspace ids are stable:
# 1000 * (monitor number) + n.

NIRI_VERSION = "26.04 (mmsimpulse)"
NIRI_TRANSFORM = {0: "Normal", 1: "90", 2: "180", 3: "270"}


def kscreen_outputs():
    """{name: (modes, current index, physical size)} from KWin, through kscreen-doctor."""
    try:
        res = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=5)
        outs = json.loads(res.stdout)["outputs"]
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        return {}
    info = {}
    for o in outs:
        modes = [{"width": m["size"]["width"], "height": m["size"]["height"],
                  "refresh_rate": int(round(m["refreshRate"] * 1000)),
                  "is_preferred": m["id"] in o.get("preferredModes", [])} for m in o.get("modes", [])]
        ids = [m["id"] for m in o.get("modes", [])]
        cur = ids.index(o["currentModeId"]) if o.get("currentModeId") in ids else None
        size = o.get("sizeMM") or {}
        info[o["name"]] = (modes, cur, [size["width"], size["height"]] if size.get("width") else None)
    return info


def niri_view(payload, desktops, window_ids, output_ids, stamps, modes=None):
    """niri's Workspaces, Windows and Outputs, and the focused output and window."""
    by_uuid = {d[1]: int(d[0]) + 1 for d in desktops}
    count = len(desktops) or 1
    outs = payload.get("outputs", [])
    for o in outs:
        output_ids.setdefault(o.get("name", ""), len(output_ids) + 1)
    focused_out = payload.get("cursorOutput") or payload.get("activeOutput") or (outs[0]["name"] if outs else "")
    shown = {o.get("name", ""): by_uuid.get(o.get("currentDesktop", ""), 1) for o in outs}
    ws_id = lambda out, n: 1000 * output_ids.setdefault(out, len(output_ids) + 1) + n

    windows, newest = [], {}
    for w in payload.get("windows", []):
        uuid = normalize_uuid(w.get("id", ""))
        wid = window_ids.setdefault(uuid, len(window_ids) + 1)
        out = w.get("output") or focused_out
        on = [by_uuid[u] for u in w.get("desktops", []) if u in by_uuid]
        n = on[0] if on else shown.get(out, 1)
        space = ws_id(out, n)
        stamp = stamps.get(wid)
        o = next((o for o in outs if o.get("name") == out), {})
        windows.append({
            "id": wid, "title": w.get("title", ""), "app_id": w.get("appId", ""),
            "pid": w.get("pid") or None, "workspace_id": space,
            "is_focused": bool(w.get("active")), "is_floating": True, "is_urgent": False,
            "layout": {"pos_in_scrolling_layout": None,
                       "tile_size": [float(w.get("width", 0)), float(w.get("height", 0))],
                       "window_size": [int(w.get("width", 0)), int(w.get("height", 0))],
                       "tile_pos_in_workspace_view": [float(w.get("x", 0) - o.get("x", 0)),
                                                      float(w.get("y", 0) - o.get("y", 0))],
                       "window_offset_in_tile": [0.0, 0.0]},
            "focus_timestamp": {"secs": stamp // 10 ** 9, "nanos": stamp % 10 ** 9} if stamp else None,
        })
        if not w.get("minimized") and (space not in newest or (stamp or 0) > newest[space][0]):
            newest[space] = (stamp or 0, wid)

    workspaces = []
    for o in outs:
        out = o.get("name", "")
        for n in range(1, count + 1):
            active = shown.get(out) == n
            workspaces.append({
                "id": ws_id(out, n), "idx": n, "name": None, "output": out, "is_urgent": False,
                "is_active": active, "is_focused": active and out == focused_out,
                "active_window_id": newest.get(ws_id(out, n), (0, None))[1],
            })

    outputs = {}
    for o in outs:
        name = o.get("name", "")
        outputs[name] = {
            "name": name, "make": o.get("make", ""), "model": o.get("model", ""),
            "serial": o.get("serial") or None, "physical_size": (modes or {}).get(name, ([], None, None))[2],
            "modes": (modes or {}).get(name, ([], None, None))[0],
            "current_mode": (modes or {}).get(name, ([], None, None))[1],
            "is_custom_mode": False, "vrr_supported": False, "vrr_enabled": False, "max_bpc": None,
            "logical": {"x": int(o.get("x", 0)), "y": int(o.get("y", 0)),
                        "width": int(o.get("width", 0)), "height": int(o.get("height", 0)),
                        "scale": float(o.get("scale", 1)), "transform": "Normal"},
        }
    focused = next((w["id"] for w in windows if w["is_focused"]), None)
    return {"workspaces": workspaces, "windows": windows, "outputs": outputs,
            "focused_output": focused_out, "focused_window": focused}


def niri_events(old, new, layouts_changed=False):
    """The events that take a client from one view to the next."""
    if old is None:
        return []
    out = []
    if [(w["id"], w["output"]) for w in old["workspaces"]] != [(w["id"], w["output"]) for w in new["workspaces"]]:
        out.append({"WorkspacesChanged": {"workspaces": new["workspaces"]}})
    else:
        before = {w["id"]: w for w in old["workspaces"]}
        for w in new["workspaces"]:
            b = before[w["id"]]
            if w["is_active"] and (not b["is_active"] or w["is_focused"] != b["is_focused"]):
                out.append({"WorkspaceActivated": {"id": w["id"], "focused": w["is_focused"]}})
            if w["active_window_id"] != b["active_window_id"]:
                out.append({"WorkspaceActiveWindowChanged": {"workspace_id": w["id"],
                                                             "active_window_id": w["active_window_id"]}})
    before = {w["id"]: w for w in old["windows"]}
    now = {w["id"]: w for w in new["windows"]}
    for wid in before:
        if wid not in now:
            out.append({"WindowClosed": {"id": wid}})
    for wid, w in now.items():
        b = before.get(wid)
        if b is None or {k: v for k, v in w.items() if k not in ("layout", "focus_timestamp", "is_focused")} != \
                {k: v for k, v in b.items() if k not in ("layout", "focus_timestamp", "is_focused")}:
            out.append({"WindowOpenedOrChanged": {"window": w}})
    changes = [[wid, w["layout"]] for wid, w in now.items() if wid in before and before[wid]["layout"] != w["layout"]]
    if changes:
        out.append({"WindowLayoutsChanged": {"changes": changes}})
    if old["focused_window"] != new["focused_window"]:
        out.append({"WindowFocusChanged": {"id": new["focused_window"]}})
    return out


def track_focus(payload, window_ids, stamps, holder):
    """Stamp the window that just got focus: KWin keeps no focus times to ask."""
    active = next((normalize_uuid(w.get("id", "")) for w in payload.get("windows", []) if w.get("active")), None)
    if active and active != getattr(holder, "focused", None):
        stamps[window_ids.setdefault(active, len(window_ids) + 1)] = time.time_ns()
    holder.focused = active


class NiriIpc:
    """The socket. Lives in the bridge's main loop, next to KWin's state."""

    def __init__(self, bridge, path):
        self.bridge, self.path = bridge, path
        self.window_ids, self.output_ids, self.stamps = {}, {}, {}
        self.view, self.streams, self.focused = None, [], None
        self.layout, self.modes = None, {}
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.bind(path)
        os.chmod(path, 0o600)
        self.sock.listen(16)
        self.sock.setblocking(False)
        GLib.io_add_watch(self.sock.fileno(), GLib.IO_IN, self.accept)
        try:
            bridge.bus.add_signal_receiver(self.layouts_changed, signal_name="layoutListChanged",
                                           dbus_interface="org.kde.KeyboardLayouts", path="/Layouts")
            bridge.bus.add_signal_receiver(self.layout_switched, signal_name="layoutChanged",
                                           dbus_interface="org.kde.KeyboardLayouts", path="/Layouts")
        except dbus.DBusException:
            pass

    # -- state ----------------------------------------------------------
    def current(self):
        if self.view is None:
            self.refresh(send=False)
        return self.view

    def refresh(self, send=True):
        try:
            desktops = self.bridge.desktops()
        except dbus.DBusException:
            return
        payload = self.bridge.payload
        track_focus(payload, self.window_ids, self.stamps, self)
        # Modes change rarely and cost a process: asked again when the
        # monitors' layout changes.
        layout = [(o.get("name"), o.get("width"), o.get("height"), o.get("scale")) for o in payload.get("outputs", [])]
        if layout != self.layout:
            self.layout, self.modes = layout, kscreen_outputs()
        new = niri_view(payload, desktops, self.window_ids, self.output_ids, self.stamps, self.modes)
        events, self.view = niri_events(self.view, new), new
        if send:
            for e in events:
                self.broadcast(e)

    def keyboard(self):
        try:
            kb = self.bridge.bus.get_object("org.kde.keyboard", "/Layouts")
            names = [str(l[2]) for l in kb.getLayoutsList(dbus_interface="org.kde.KeyboardLayouts")]
            return {"names": names, "current_idx": int(kb.getLayout(dbus_interface="org.kde.KeyboardLayouts"))}
        except dbus.DBusException:
            return {"names": [], "current_idx": 0}

    def layouts_changed(self, *_):
        self.broadcast({"KeyboardLayoutsChanged": {"keyboard_layouts": self.keyboard()}})

    def layout_switched(self, idx, *_):
        self.broadcast({"KeyboardLayoutSwitched": {"idx": int(idx)}})

    # -- clients ----------------------------------------------------------
    def accept(self, *_):
        try:
            conn, _ = self.sock.accept()
        except OSError:
            return True
        conn.setblocking(False)
        client = {"conn": conn, "buf": b"", "stream": False}
        GLib.io_add_watch(conn.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.readable, client)
        return True

    def readable(self, _fd, cond, client):
        try:
            data = client["conn"].recv(65536)
        except BlockingIOError:
            return True
        except OSError:
            data = b""
        if not data or cond & (GLib.IO_HUP | GLib.IO_ERR):
            # A client may shut down its side after asking for the event
            # stream (niri msg does); the stream goes on until a write fails.
            if not (client["stream"] and not data and not cond & GLib.IO_ERR):
                self.drop(client)
            return False
        client["buf"] += data
        while b"\n" in client["buf"]:
            line, client["buf"] = client["buf"].split(b"\n", 1)
            if line.strip():
                self.answer(client, line)
        return True

    def send(self, client, obj):
        try:
            client["conn"].setblocking(True)
            client["conn"].sendall((json.dumps(obj) + "\n").encode())
            client["conn"].setblocking(False)
        except OSError:
            self.drop(client)

    def drop(self, client):
        if client in self.streams:
            self.streams.remove(client)
        try:
            client["conn"].close()
        except OSError:
            pass

    def broadcast(self, event):
        for client in list(self.streams):
            self.send(client, event)

    def answer(self, client, line):
        request = None
        try:
            request = json.loads(line)
            reply = {"Ok": self.process(request)}
        except Exception as exc:  # a bad request answers, it does not take the bridge down
            reply = {"Err": str(exc)}
        self.send(client, reply)
        if request == "EventStream" and "Ok" in reply:
            v = self.current()
            client["stream"] = True
            self.streams.append(client)
            for e in ({"WorkspacesChanged": {"workspaces": v["workspaces"]}},
                      {"WindowsChanged": {"windows": v["windows"]}},
                      {"KeyboardLayoutsChanged": {"keyboard_layouts": self.keyboard()}},
                      {"OverviewOpenedOrClosed": {"is_open": False}},
                      {"ConfigLoaded": {"failed": False}}):
                self.send(client, e)

    # -- requests ---------------------------------------------------------
    def process(self, request):
        v = self.current()
        simple = {
            "Version": lambda: {"Version": NIRI_VERSION},
            "Windows": lambda: {"Windows": v["windows"]},
            "Workspaces": lambda: {"Workspaces": v["workspaces"]},
            "Outputs": lambda: {"Outputs": v["outputs"]},
            "FocusedOutput": lambda: {"FocusedOutput": v["outputs"].get(v["focused_output"])},
            "FocusedWindow": lambda: {"FocusedWindow": next((w for w in v["windows"] if w["is_focused"]), None)},
            "KeyboardLayouts": lambda: {"KeyboardLayouts": self.keyboard()},
            "OverviewState": lambda: {"OverviewState": {"is_open": False}},
            "Layers": lambda: {"Layers": []},
            "Casts": lambda: {"Casts": []},
            "EventStream": lambda: "Handled",
        }
        if isinstance(request, str) and request in simple:
            return simple[request]()
        if isinstance(request, dict) and "Action" in request:
            action = request["Action"]
            name, args = (action, {}) if isinstance(action, str) else next(iter(action.items()))
            self.act(name, args or {}, v)
            return "Handled"
        raise ValueError("mmsimpulse does not answer %s" % json.dumps(request)[:80])

    def uuid(self, wid, v):
        if wid is None:
            wid = v["focused_window"]
        return next((u for u, i in self.window_ids.items() if i == wid), None)

    def space(self, ref, v):
        """(output, n) of a workspace reference."""
        kind, val = next(iter(ref.items()))
        if kind == "Id":
            w = next((w for w in v["workspaces"] if w["id"] == val), None)
            return (w["output"], w["idx"]) if w else None
        if kind == "Index":
            return v["focused_output"], int(val)
        raise ValueError("workspace %s" % kind)

    def act(self, name, args, v):
        b = self.bridge
        if name == "FocusWindow":
            b.WindowAction(self.uuid(args.get("id"), v), "activate", "")
        elif name == "CloseWindow":
            b.WindowAction(self.uuid(args.get("id"), v), "close", "")
        elif name in ("FullscreenWindow", "ToggleWindowedFullscreen"):
            b.WindowAction(self.uuid(args.get("id"), v), "fullscreen", "")
        elif name in ("MaximizeColumn", "MaximizeWindowToEdges"):
            b.WindowAction(self.uuid(args.get("id"), v), "maximize", "")
        elif name == "CenterWindow":
            b.WindowAction(self.uuid(args.get("id"), v), "center", "")
        elif name == "FocusWorkspace":
            where = self.space(args["reference"], v)
            if where:
                b.SetDesktopForOutput(*where)
        elif name in ("FocusWorkspaceUp", "FocusWorkspaceDown", "FocusWorkspacePrevious"):
            shortcut = "mmsimpulse: %s workspace" % ("Next" if name == "FocusWorkspaceDown" else "Previous")
            invoke_shortcut(b.bus, "kwin", shortcut)
        elif name in ("MoveWindowToWorkspace", "MoveColumnToWorkspace"):
            where = self.space(args["reference"], v)
            target = self.uuid(args.get("window_id"), v)
            if where and target:
                b.WindowAction(target, "move", str(where[1]))
                if args.get("focus", True):
                    b.SetDesktopForOutput(*where)
        elif name in ("ToggleWindowFloating", "SetWindowFloating", "SetWindowTiling",
                      "SwitchFocusBetweenFloatingAndTiling", "FocusFloating", "FocusTiling"):
            pass  # every window floats here
        elif name == "SwitchLayout":
            kb = b.bus.get_object("org.kde.keyboard", "/Layouts")
            layout = args.get("layout")
            n = len(self.keyboard()["names"]) or 1
            cur = self.keyboard()["current_idx"]
            idx = layout["Index"] if isinstance(layout, dict) else (cur + (1 if layout == "Next" else -1)) % n
            kb.setLayout(dbus.UInt32(idx), dbus_interface="org.kde.KeyboardLayouts")
        elif name in ("PowerOffMonitors", "PowerOnMonitors"):
            subprocess.Popen(["kscreen-doctor", "--dpms", "off" if name == "PowerOffMonitors" else "on"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif name in ("ToggleOverview", "OpenOverview", "CloseOverview"):
            invoke_shortcut(b.bus, "kwin", "Overview")
        elif name == "Spawn":
            subprocess.Popen(args.get("command") or [], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif name == "SpawnSh":
            subprocess.Popen(["sh", "-c", args.get("command", "")], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif name == "Quit":
            subprocess.Popen(["sh", "-c", 'loginctl terminate-session "${XDG_SESSION_ID:-}" || pkill -x kwin_wayland'])
        else:
            raise ValueError("mmsimpulse has no %s (niri action)" % name)


# ---------------------------------------------------------------------------
# Hyprland's IPC, for shells written for Hyprland
# ---------------------------------------------------------------------------
# Two sockets under $XDG_RUNTIME_DIR/hypr/<signature>/, as Hyprland's:
# .socket.sock takes one request per connection ("j/clients", "dispatch
# workspace 2", "[[BATCH]]a;b") and closes after the answer; .socket2.sock
# streams events as "name>>data" lines. Hyprland's workspaces are already
# mmsimpulse's: 1..10, each on one monitor at a time, so they map as they are.

HYPR_VERSION = "0.55.0"


def hypr_addr(wid):
    return "0x%x" % (0x5d0000 + wid)


def hypr_view(payload, desktops, window_ids, output_ids, stamps, modes=None):
    """Hyprland's monitors, workspaces and clients, by name and id."""
    by_uuid = {d[1]: int(d[0]) + 1 for d in desktops}
    outs = payload.get("outputs", [])
    for o in outs:
        output_ids.setdefault(o.get("name", ""), len(output_ids))
    focused_out = payload.get("cursorOutput") or payload.get("activeOutput") or (outs[0]["name"] if outs else "")
    shown = {o.get("name", ""): by_uuid.get(o.get("currentDesktop", ""), 1) for o in outs}
    order = sorted(stamps, key=lambda w: -stamps[w])

    clients = []
    for w in payload.get("windows", []):
        uuid = normalize_uuid(w.get("id", ""))
        wid = window_ids.setdefault(uuid, len(window_ids) + 1)
        out = w.get("output") or focused_out
        on = [by_uuid[u] for u in w.get("desktops", []) if u in by_uuid]
        n = on[0] if on else shown.get(out, 1)
        clients.append({
            "address": hypr_addr(wid), "mapped": True, "hidden": bool(w.get("minimized")),
            "at": [int(w.get("x", 0)), int(w.get("y", 0))], "size": [int(w.get("width", 0)), int(w.get("height", 0))],
            "workspace": {"id": n, "name": str(n)}, "floating": True, "pseudo": False,
            "monitor": output_ids.get(out, 0), "class": w.get("appId", ""), "title": w.get("title", ""),
            "initialClass": w.get("appId", ""), "initialTitle": w.get("title", ""), "pid": w.get("pid") or -1,
            "xwayland": False, "pinned": not on, "fullscreen": 2 if w.get("fullscreen") else 0,
            "fullscreenClient": 2 if w.get("fullscreen") else 0, "grouped": [], "tags": [],
            "swallowing": "0x0", "focusHistoryID": order.index(wid) if wid in order else len(order) + wid,
            "inhibitingIdle": False, "xdgTag": "", "xdgDescription": "", "contentType": "none",
            "_active": bool(w.get("active")), "_output": out, "_wid": wid, "_maximized": bool(w.get("maximized")),
        })

    # A workspace exists while a monitor shows it or a window is on it.
    where = {n: out for out, n in shown.items()}
    for c in clients:
        where.setdefault(c["workspace"]["id"], c["_output"])
    workspaces = []
    for n in sorted(where):
        mine = [c for c in clients if c["workspace"]["id"] == n]
        last = min(mine, key=lambda c: c["focusHistoryID"]) if mine else None
        workspaces.append({
            "id": n, "name": str(n), "monitor": where[n], "monitorID": output_ids.get(where[n], 0),
            "windows": len(mine), "hasfullscreen": any(c["fullscreen"] for c in mine),
            "lastwindow": last["address"] if last else "0x0", "lastwindowtitle": last["title"] if last else "",
            "ispersistent": False,
        })

    monitors = []
    for o in outs:
        name = o.get("name", "")
        info = (modes or {}).get(name, ([], None, None))
        cur = info[0][info[1]] if info[1] is not None and info[1] < len(info[0]) else None
        scale = float(o.get("scale", 1))
        n = shown.get(name, 1)
        monitors.append({
            "id": output_ids.get(name, 0), "name": name,
            "description": " ".join(x for x in (o.get("make", ""), o.get("model", ""), o.get("serial", "")) if x),
            "make": o.get("make", ""), "model": o.get("model", ""), "serial": o.get("serial", ""),
            "width": cur["width"] if cur else int(o.get("width", 0) * scale),
            "height": cur["height"] if cur else int(o.get("height", 0) * scale),
            "refreshRate": cur["refresh_rate"] / 1000 if cur else 60.0,
            "x": int(o.get("x", 0)), "y": int(o.get("y", 0)),
            "activeWorkspace": {"id": n, "name": str(n)}, "specialWorkspace": {"id": 0, "name": ""},
            "reserved": [0, 0, 0, 0], "scale": scale, "transform": 0, "focused": name == focused_out,
            "dpmsStatus": True, "vrr": False, "solitary": "0", "activelyTearing": False,
            "directScanoutTo": "0", "disabled": False, "currentFormat": "XRGB8888", "mirrorOf": "none",
            "availableModes": ["%dx%d@%.2fHz" % (m["width"], m["height"], m["refresh_rate"] / 1000) for m in info[0]],
        })
    focused = next((c for c in clients if c["_active"]), None)
    return {"monitors": monitors, "workspaces": workspaces, "clients": clients,
            "focused_monitor": focused_out, "focused": focused}


def public(client):
    return {k: v for k, v in client.items() if not k.startswith("_")}


def hypr_events(old, new):
    """socket2 lines that take a client from one view to the next."""
    if old is None:
        return []
    out = []
    oldm, newm = {m["name"]: m for m in old["monitors"]}, {m["name"]: m for m in new["monitors"]}
    for name, m in newm.items():
        if name not in oldm:
            out += ["monitoradded>>%s" % name, "monitoraddedv2>>%d,%s,%s" % (m["id"], name, m["description"])]
    oldw, neww = {w["id"]: w for w in old["workspaces"]}, {w["id"]: w for w in new["workspaces"]}
    for n, w in neww.items():
        if n not in oldw:
            out += ["createworkspace>>%s" % w["name"], "createworkspacev2>>%d,%s" % (n, w["name"])]
        elif oldw[n]["monitor"] != w["monitor"]:
            out += ["moveworkspace>>%s,%s" % (w["name"], w["monitor"]),
                    "moveworkspacev2>>%d,%s,%s" % (n, w["name"], w["monitor"])]
    fm, ofm = newm.get(new["focused_monitor"]), oldm.get(old["focused_monitor"])
    if fm and (not ofm or fm["name"] != ofm["name"]):
        ws = fm["activeWorkspace"]
        out += ["focusedmon>>%s,%s" % (fm["name"], ws["name"]), "focusedmonv2>>%s,%d" % (fm["name"], ws["id"])]
    elif fm and ofm and fm["activeWorkspace"] != ofm["activeWorkspace"]:
        ws = fm["activeWorkspace"]
        out += ["workspace>>%s" % ws["name"], "workspacev2>>%d,%s" % (ws["id"], ws["name"])]
    for name, m in newm.items():  # another monitor changing what it shows
        if name != new["focused_monitor"] and name in oldm and m["activeWorkspace"] != oldm[name]["activeWorkspace"]:
            ws = m["activeWorkspace"]
            out += ["moveworkspace>>%s,%s" % (ws["name"], name), "moveworkspacev2>>%d,%s,%s" % (ws["id"], ws["name"], name)]
    oldc, newc = {c["address"]: c for c in old["clients"]}, {c["address"]: c for c in new["clients"]}
    for a, c in newc.items():
        hexa = a[2:]
        b = oldc.get(a)
        if b is None:
            out.append("openwindow>>%s,%s,%s,%s" % (hexa, c["workspace"]["name"], c["class"], c["title"]))
            continue
        if b["workspace"] != c["workspace"]:
            out += ["movewindow>>%s,%s" % (hexa, c["workspace"]["name"]),
                    "movewindowv2>>%s,%d,%s" % (hexa, c["workspace"]["id"], c["workspace"]["name"])]
        if b["title"] != c["title"]:
            out += ["windowtitle>>%s" % hexa, "windowtitlev2>>%s,%s" % (hexa, c["title"])]
    for a in oldc:
        if a not in newc:
            out.append("closewindow>>%s" % a[2:])
    fo, ff = old["focused"], new["focused"]
    if (fo and fo["address"]) != (ff and ff["address"]):
        out += ["activewindow>>%s,%s" % ((ff["class"], ff["title"]) if ff else ("", "")),
                "activewindowv2>>%s" % (ff["address"][2:] if ff else "")]
    if ff and fo and fo["address"] == ff["address"] and fo["fullscreen"] != ff["fullscreen"]:
        out.append("fullscreen>>%d" % (1 if ff["fullscreen"] else 0))
    for name in oldm:
        if name not in newm:
            out += ["monitorremoved>>%s" % name,
                    "monitorremovedv2>>%d,%s,%s" % (oldm[name]["id"], name, oldm[name]["description"])]
    for n, w in oldw.items():
        if n not in neww:
            out += ["destroyworkspace>>%s" % w["name"], "destroyworkspacev2>>%d,%s" % (n, w["name"])]
    return out


class HyprIpc:
    """Hyprland's two sockets, next to KWin's state in the bridge's main loop."""

    def __init__(self, bridge, directory, ids):
        self.bridge, self.dir = bridge, directory
        self.window_ids, self.output_ids, self.stamps = ids
        self.view, self.events, self.layout, self.modes = None, [], None, {}
        os.makedirs(directory, mode=0o700, exist_ok=True)
        self.req = self.listen(os.path.join(directory, ".socket.sock"), self.request)
        self.evt = self.listen(os.path.join(directory, ".socket2.sock"), self.subscribe)
        try:
            bridge.bus.add_signal_receiver(self.layout_switched, signal_name="layoutChanged",
                                           dbus_interface="org.kde.KeyboardLayouts", path="/Layouts")
        except dbus.DBusException:
            pass

    def listen(self, path, handler):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.bind(path)
        os.chmod(path, 0o600)
        sock.listen(32)
        sock.setblocking(False)
        GLib.io_add_watch(sock.fileno(), GLib.IO_IN, lambda *_: handler(sock) or True)
        return sock

    # -- state ------------------------------------------------------------
    def current(self):
        if self.view is None:
            self.refresh(send=False)
        return self.view

    def refresh(self, send=True):
        try:
            desktops = self.bridge.desktops()
        except dbus.DBusException:
            return
        payload = self.bridge.payload
        layout = [(o.get("name"), o.get("width"), o.get("height"), o.get("scale")) for o in payload.get("outputs", [])]
        if layout != self.layout:
            self.layout, self.modes = layout, kscreen_outputs()
        new = hypr_view(payload, desktops, self.window_ids, self.output_ids, self.stamps, self.modes)
        lines, self.view = hypr_events(self.view, new), new
        if send:
            for line in lines:
                self.broadcast(line)

    def keyboard(self):
        try:
            kb = self.bridge.bus.get_object("org.kde.keyboard", "/Layouts")
            names = [str(l[2]) for l in kb.getLayoutsList(dbus_interface="org.kde.KeyboardLayouts")]
            short = [str(l[0]) for l in kb.getLayoutsList(dbus_interface="org.kde.KeyboardLayouts")]
            return names, short, int(kb.getLayout(dbus_interface="org.kde.KeyboardLayouts"))
        except dbus.DBusException:
            return [], [], 0

    def layout_switched(self, idx, *_):
        names = self.keyboard()[0]
        if int(idx) < len(names):
            self.broadcast("activelayout>>mmsimpulse-keyboard,%s" % names[int(idx)])

    # -- sockets ----------------------------------------------------------
    def subscribe(self, sock):
        try:
            conn, _ = sock.accept()
        except OSError:
            return
        conn.setblocking(True)
        self.events.append(conn)

    def broadcast(self, line):
        for conn in list(self.events):
            try:
                conn.sendall((line + "\n").encode())
            except OSError:
                self.events.remove(conn)
                conn.close()

    def request(self, sock):
        try:
            conn, _ = sock.accept()
        except OSError:
            return
        conn.settimeout(1)
        data = b""
        try:
            while True:  # one request; the client then waits for the answer
                chunk = conn.recv(65536)
                data += chunk
                if not chunk or len(chunk) < 65536:
                    break
        except OSError:
            pass
        try:
            text = data.decode(errors="replace").strip()
            if text.startswith("[[BATCH]]"):
                reply = "\n\n".join(self.answer(c.strip()) for c in text[9:].split(";") if c.strip())
            else:
                reply = self.answer(text)
        except Exception as exc:  # a bad request answers, it does not take the bridge down
            reply = "error: %s" % exc
        try:
            conn.sendall(reply.encode())
        except OSError:
            pass
        conn.close()

    def answer(self, text):
        flags, _, rest = text.partition("/") if "/" in text.split(" ", 1)[0] else ("", "", text)
        cmd, _, args = rest.partition(" ")
        v = self.current()
        as_json = "j" in flags
        dump = lambda x: json.dumps(x, indent=2) if as_json else json.dumps(x)
        if cmd == "version":
            info = {"branch": "", "commit": "mmsimpulse", "version": HYPR_VERSION, "dirty": False,
                    "commit_message": "", "commit_date": "", "tag": "v" + HYPR_VERSION, "commits": "0",
                    "buildAquamarine": "", "buildHyprlang": "", "buildHyprutils": "", "buildHyprcursor": "",
                    "buildHyprgraphics": "", "systemAquamarine": "", "systemHyprlang": "", "systemHyprutils": "",
                    "systemHyprcursor": "", "systemHyprgraphics": "", "abiHash": "", "flags": []}
            return dump(info) if as_json else "Hyprland %s (mmsimpulse: KWin answering Hyprland's IPC)" % HYPR_VERSION
        if cmd == "status":
            return dump({"configProvider": "hyprlang", "version": HYPR_VERSION})
        if cmd == "monitors":
            return dump(v["monitors"])
        if cmd == "workspaces":
            return dump(v["workspaces"])
        if cmd == "activeworkspace":
            m = next((m for m in v["monitors"] if m["focused"]), None)
            n = m["activeWorkspace"]["id"] if m else 1
            w = next((w for w in v["workspaces"] if w["id"] == n), None)
            return dump(w or {"id": n, "name": str(n), "monitor": m["name"] if m else "", "monitorID": 0,
                              "windows": 0, "hasfullscreen": False, "lastwindow": "0x0",
                              "lastwindowtitle": "", "ispersistent": False})
        if cmd == "clients":
            return dump([public(c) for c in v["clients"]])
        if cmd == "activewindow":
            return dump(public(v["focused"]) if v["focused"] else {})
        if cmd == "devices":
            names, short, cur = self.keyboard()
            kb = {"address": "0x1", "name": "mmsimpulse-keyboard", "rules": "", "model": "",
                  "layout": ",".join(short), "variant": "", "options": "",
                  "active_keymap": names[cur] if cur < len(names) else "", "active_layout_index": cur,
                  "capsLock": False, "numLock": False, "main": True}
            return dump({"mice": [], "keyboards": [kb], "tablets": [], "touch": [], "switches": []})
        if cmd in ("layers", "binds", "animations", "workspacerules", "globalshortcuts", "layouts"):
            return dump({} if cmd == "layers" else [])
        if cmd == "getoption":
            return dump({"option": args.strip(), "int": 0, "float": 0.0, "str": "", "set": False})
        if cmd in ("keyword", "reload", "setcursor", "notify", "dismissnotify", "seterror", "decorations"):
            return "ok"  # Hyprland's own settings: KWin has its own
        if cmd == "dispatch":
            return self.dispatch(args.strip(), v)
        return "unknown request"

    # -- dispatchers ------------------------------------------------------
    def window(self, spec, v):
        """A client by Hyprland's window spec, or the focused one."""
        spec = spec.strip()
        if not spec or spec == "activewindow":
            return v["focused"]
        kind, _, val = spec.partition(":") if ":" in spec else ("class", "", spec)
        for c in v["clients"]:
            if (kind == "address" and int(c["address"], 16) == int(val, 16)) or \
               (kind in ("class", "initialclass") and re.search(val, c["class"])) or \
               (kind in ("title", "initialtitle") and re.search(val, c["title"])) or \
               (kind == "pid" and str(c["pid"]) == val):
                return c
        return None

    def uuid(self, client):
        return next((u for u, i in self.window_ids.items() if i == client["_wid"]), None) if client else None

    def workspace_number(self, arg, v):
        arg = arg.strip()
        if arg.startswith("name:"):
            arg = arg[5:]
        if arg.isdigit():
            return int(arg)
        m = next((m for m in v["monitors"] if m["focused"]), None)
        cur = m["activeWorkspace"]["id"] if m else 1
        step = re.fullmatch(r"[emr]?([+-]\d+)", arg)
        if step:
            return min(max(cur + int(step.group(1)), 1), len(self.bridge.desktops()) or 10)
        raise ValueError(arg)

    def dispatch(self, text, v):
        name, _, args = text.partition(" ")
        b = self.bridge
        if name == "workspace":
            if args.strip() == "previous":
                invoke_shortcut(b.bus, "kwin", "Switch to Previous Desktop")
            else:
                n = self.workspace_number(args, v)
                invoke_shortcut(b.bus, "kwin", "mmsimpulse: Switch to workspace %d" % n)
        elif name in ("movetoworkspace", "movetoworkspacesilent"):
            ws, _, spec = args.partition(",")
            n = self.workspace_number(ws, v)
            c = self.window(spec, v)
            if not c:
                return "No such window"
            b.WindowAction(self.uuid(c), "move", str(n))
            if name == "movetoworkspace":
                invoke_shortcut(b.bus, "kwin", "mmsimpulse: Switch to workspace %d" % n)
        elif name == "focuswindow":
            c = self.window(args, v)
            if not c:
                return "No such window"
            b.WindowAction(self.uuid(c), "activate", "")
        elif name in ("closewindow", "killwindow", "killactive", "forcekillactive"):
            c = self.window(args if name in ("closewindow", "killwindow") else "", v)
            if c:
                b.WindowAction(self.uuid(c), "close", "")
        elif name == "fullscreen":
            c = v["focused"]
            if c:
                b.WindowAction(self.uuid(c), "maximize" if args.strip() == "1" else "fullscreen", "")
        elif name == "pin":
            c = self.window(args, v)
            if c:
                b.WindowAction(self.uuid(c), "pin", "")
        elif name == "movefocus":
            d = {"l": "Left", "r": "Right", "u": "Up", "d": "Down"}.get(args.strip()[:1])
            if d:
                invoke_shortcut(b.bus, "kwin", "Switch Window " + d)
        elif name in ("exec", "execr"):
            cmd = re.sub(r"^\[[^]]*\]\s*", "", args)  # [rules] in front: KWin rules do that here
            subprocess.Popen(["sh", "-c", cmd], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif name == "switchxkblayout":
            names, _, cur = self.keyboard()
            arg = args.split()[-1] if args.split() else "next"
            idx = {"next": cur + 1, "prev": cur - 1}.get(arg, int(arg) if arg.lstrip("-").isdigit() else cur)
            b.bus.get_object("org.kde.keyboard", "/Layouts").setLayout(
                dbus.UInt32(idx % (len(names) or 1)), dbus_interface="org.kde.KeyboardLayouts")
        elif name == "dpms":
            state = args.split()[0] if args.split() else "toggle"
            subprocess.Popen(["kscreen-doctor", "--dpms", "off" if state == "off" else "on"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif name == "exit":
            subprocess.Popen(["sh", "-c", 'loginctl terminate-session "${XDG_SESSION_ID:-}" || pkill -x kwin_wayland'])
        elif name in ("togglefloating", "setfloating", "settiled", "pseudo", "centerwindow"):
            if name == "centerwindow" and v["focused"]:
                b.WindowAction(self.uuid(v["focused"]), "center", "")
        else:
            return "Invalid dispatcher"
        return "ok"


def invoke_shortcut(bus, component, name):
    bus.get_object("org.kde.kglobalaccel", "/component/" + component).invokeShortcut(
        name, dbus_interface="org.kde.kglobalaccel.Component")


# ---------------------------------------------------------------------------
# D-Bus plumbing
# ---------------------------------------------------------------------------

class Bridge(dbus.service.Object):
    def __init__(self, bus):
        # Take the name outright rather than queueing behind an older copy.
        # A queued owner still runs and still looks healthy, but the KWin
        # script's pushes go to whoever holds the name, so it sits there
        # publishing nothing but virtual desktops — which is exactly what an
        # orphaned bridge from a previous shell caused.
        name = dbus.service.BusName(
            BUS_NAME, bus,
            allow_replacement=True, replace_existing=True, do_not_queue=True)
        super().__init__(name, OBJ_PATH)
        self.bus = bus
        self.payload = {"windows": [], "activeOutput": ""}
        self.pending = None
        self.oneshot = 0
        # niri's IPC, when the session asks for it (mms.ipc("niri")).
        path = os.environ.get("MMSIMPULSE_NIRI_SOCKET")
        self.niri = NiriIpc(self, path) if path else None
        # Hyprland's, when it asks for that (mms.ipc("hyprland")); the window
        # ids are shared, so both name a window alike.
        his = os.environ.get("MMSIMPULSE_HYPRLAND_SIGNATURE")
        ids = (self.niri.window_ids, self.niri.output_ids, self.niri.stamps) if self.niri else ({}, {}, {})
        self.hypr = HyprIpc(self, os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hypr", his), ids) \
            if his else None

        bus.add_signal_receiver(
            self.schedule, dbus_interface=VDM_IFACE, bus_name=KWIN)
        bus.add_signal_receiver(
            self.on_kwin_owner_changed, signal_name="NameOwnerChanged",
            dbus_interface="org.freedesktop.DBus", arg0=KWIN)

        GLib.idle_add(self.load_script)
        self.schedule()

    # -- inbound from the KWin script -------------------------------------
    @dbus.service.method(BUS_NAME, in_signature="s", out_signature="")
    def Update(self, raw):
        try:
            self.payload = json.loads(raw)
        except ValueError as exc:
            print(f"[bridge] bad payload: {exc}", file=sys.stderr, flush=True)
            return
        self.schedule()

    # -- inbound from the shell -------------------------------------------
    @dbus.service.method(BUS_NAME, in_signature="ib", out_signature="")
    def MoveActiveWindowToDesktop(self, position, follow):
        self.run_once(move_active_script(position, follow))

    @dbus.service.method(BUS_NAME, in_signature="s", out_signature="")
    def ResizeActiveWindow(self, direction):
        if direction in RESIZE:
            self.run_once(resize_active_script(direction))

    @dbus.service.method(BUS_NAME, in_signature="si", out_signature="")
    def SetDesktopForOutput(self, output_name, position):
        self.run_once(desktop_script(output_name, position))

    @dbus.service.method(BUS_NAME, in_signature="", out_signature="s")
    def Snapshot(self):
        """The same state emit() streams, for callers that cannot read stdout."""
        try:
            return json.dumps(self.state())
        except dbus.DBusException as exc:
            print(f"[bridge] KWin unreachable: {exc}", file=sys.stderr, flush=True)
            return "{}"

    @dbus.service.method(BUS_NAME, in_signature="s", out_signature="")
    def SwitchToConsole(self, vt):
        """Ctrl+Alt+N from the KWin script. KWin switches consoles itself on
        Ctrl+Alt+F-keys, but keyboards whose F-row sends media keys by default
        never produce those. logind allows the switch to the active session."""
        try:
            dbus.SystemBus().call_blocking(
                "org.freedesktop.login1", "/org/freedesktop/login1/seat/seat0",
                "org.freedesktop.login1.Seat", "SwitchTo", "u", [dbus.UInt32(int(vt))])
        except (dbus.DBusException, ValueError) as exc:
            print(f"[bridge] console {vt}: {exc}", file=sys.stderr, flush=True)

    @dbus.service.method(BUS_NAME, in_signature="sss", out_signature="")
    def WindowAction(self, window_uuid, action, value):
        try:
            self.run_once(window_script(window_uuid, action, value))
        except ValueError as exc:
            print(f"[bridge] {exc}", file=sys.stderr, flush=True)

    # -- outbound ----------------------------------------------------------
    def schedule(self, *_args):
        if self.pending is None:
            self.pending = GLib.timeout_add(DEBOUNCE_MS, self.emit)

    def desktops(self):
        vdm = dbus.Interface(
            self.bus.get_object(KWIN, "/VirtualDesktopManager"),
            "org.freedesktop.DBus.Properties")
        return [(int(d[0]), str(d[1]), str(d[2])) for d in vdm.Get(VDM_IFACE, "desktops")]

    def state(self):
        vdm = dbus.Interface(
            self.bus.get_object(KWIN, "/VirtualDesktopManager"),
            "org.freedesktop.DBus.Properties")
        current = str(vdm.Get(VDM_IFACE, "current"))
        return build_snapshot(self.payload, self.desktops(), current)

    def emit(self):
        self.pending = None
        try:
            snapshot = self.state()
        except dbus.DBusException as exc:
            print(f"[bridge] KWin unreachable: {exc}", file=sys.stderr, flush=True)
            return GLib.SOURCE_REMOVE
        print(json.dumps(snapshot), flush=True)
        if self.niri:
            self.niri.refresh()
        if self.hypr:
            if not self.niri:
                track_focus(self.payload, self.hypr.window_ids, self.hypr.stamps, self.hypr)
            self.hypr.refresh()
        return GLib.SOURCE_REMOVE

    # -- KWin script lifecycle --------------------------------------------
    def scripting(self):
        return dbus.Interface(
            self.bus.get_object(KWIN, "/Scripting"), "org.kde.kwin.Scripting")

    def load_script(self, attempt=0):
        """Replace any previously loaded copy of the script, then run it.

        unloadScript destroys the Script with deleteLater(), so the plugin name
        stays registered until KWin's event loop turns; a loadScript issued
        before that returns -1 and silently adds nothing. Hence the retry: one
        pass unloads, a later one loads.
        """
        try:
            s = self.scripting()
            if s.isScriptLoaded(SCRIPT_NAME):
                s.unloadScript(SCRIPT_NAME)
            else:
                # loadScript is overloaded (s and ss); dbus-python would pick
                # the single-argument form off introspection and then fail, so
                # the signature has to be named explicitly.
                if s.loadScript(SCRIPT, SCRIPT_NAME, signature="ss") >= 0:
                    s.start()
                    return GLib.SOURCE_REMOVE
        except dbus.DBusException as exc:
            print(f"[bridge] could not load KWin script: {exc}",
                  file=sys.stderr, flush=True)
            return GLib.SOURCE_REMOVE

        if attempt < 20:
            GLib.timeout_add(100, self.load_script, attempt + 1)
        else:
            print("[bridge] gave up loading the KWin script", file=sys.stderr, flush=True)
        return GLib.SOURCE_REMOVE

    def run_once(self, source):
        with tempfile.NamedTemporaryFile("w", suffix=".js", delete=False) as fh:
            fh.write(source)
            path = fh.name
        try:
            s = self.scripting()
            # Unique name per call, for the same deleteLater() reason as above.
            name = f"mmsimpulse-oneshot-{self.oneshot}"
            self.oneshot += 1
            s.loadScript(path, name, signature="ss")
            s.start()
            s.unloadScript(name)
        except dbus.DBusException as exc:
            print(f"[bridge] one-shot failed: {exc}", file=sys.stderr, flush=True)
        finally:
            os.unlink(path)

    def on_kwin_owner_changed(self, _name, _old, new):
        # KWin restarted (kwin_wayland --replace); the script died with it.
        if new:
            GLib.timeout_add(500, lambda: (self.load_script(), self.schedule())
                             and GLib.SOURCE_REMOVE)  # noqa: E501


def die_with_parent():
    """Quickshell reaps this process on a clean exit, but not when it is killed.

    Without this an orphaned bridge keeps the bus name and every later one is
    deaf, which looks like the window list simply not working.
    """
    PR_SET_PDEATHSIG = 1
    try:
        ctypes.CDLL("libc.so.6", use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGTERM)
    except OSError as exc:
        print(f"[bridge] no PDEATHSIG: {exc}", file=sys.stderr, flush=True)


def main():
    die_with_parent()
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    try:
        Bridge(dbus.SessionBus())
    except dbus.exceptions.NameExistsException:
        print("[bridge] another bridge refuses to yield the bus name",
              file=sys.stderr, flush=True)
        return 1
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
